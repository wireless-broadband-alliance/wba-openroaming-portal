<div class="bg-white rounded-lg transition-all duration-300 px-10 py-[35px] h-[calc(90%)] lg:h-[calc(80%)] w-[810px] overflow-auto">

    <div class="flex flex-row justify-start items-center">
        <h1 class="text-primary text-xl font-semibold">{{ 'title'|trans({}, '_account_widget') }}</h1>
        <button type="button"
                class="ml-auto flex flex-row justify-end gap-x-[12px] items-center text-[#707070]" {{ stimulus_action('widget', 'close') }}>
            <span>{{ 'close'|trans({}, '_account_widget') }}</span>
            <twig:ux:icon name="wba:cross-circle-rounded" class="w-6 h-auto fill-current" />
        </button>
    </div>

    {# Personal Data Form #}
    {% set has_first_name_errors = form.firstName.vars.errors|length > 0 %}
    {% set has_last_name_errors = form.lastName.vars.errors|length > 0 %}
    {% set has_personal_errors = has_first_name_errors or has_last_name_errors or form.vars.errors|length > 0 %}

    <div {{ stimulus_controller('fields') }}>
        <h1 class="text-lg mb-8 mt-10">{{ 'personalData.title'|trans({}, '_account_widget') }}</h1>

        {{ form_start(form, {action: path('app_landing_account_user')}) }}

        <div class="flex flex-col gap-y-4">
            <div class="flex flex-col lg:flex-row gap-x-6 gap-y-8">
                {# First Name #}
                <div class="relative w-full">
                    {{ form_label(form.firstName, 'personalData.firstName'|trans({}, '_account_widget'), {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.firstName, {attr: {
                        class: 'form-widget ' ~ (has_first_name_errors ? '!border-red-500 focus:!ring-red-500 focus:!border-red-500' : ''),
                        'data-fields-target': 'input',
                        'data-action': 'fields#input_changed',
                    }}) }}
                </div>

                {# Last Name #}
                <div class="relative w-full">
                    {{ form_label(form.lastName, 'personalData.lastName'|trans({}, '_account_widget'), {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.lastName, {attr: {
                        class: 'form-widget ' ~ (has_last_name_errors ? '!border-red-500 focus:!ring-red-500 focus:!border-red-500' : ''),
                        'data-fields-target': 'input',
                        'data-action': 'fields#input_changed',
                    }}) }}
                </div>
            </div>

            {# Personal Data Errors #}
            {% if has_personal_errors %}
                <div class="w-full text-xs font-medium text-red-700 bg-red-50 border border-red-200 rounded-lg p-3.5 flex flex-col gap-3 shadow-sm">
                    {% if form.vars.errors|length > 0 %}
                        <div class="flex items-start gap-2.5">
                            <div class="flex-1 [&>ul]:list-disc [&>ul]:pl-4 [&>ul]:space-y-1 text-red-600">
                                {{ form_errors(form) }}
                            </div>
                        </div>
                    {% endif %}
                    {% if has_first_name_errors %}
                        <div class="flex items-start gap-2.5">
                            <div class="flex-1 [&>ul]:list-disc [&>ul]:pl-4 [&>ul]:space-y-1 text-red-600">
                                {{ form_errors(form.firstName) }}
                            </div>
                        </div>
                    {% endif %}
                    {% if has_last_name_errors %}
                        <div class="flex items-start gap-2.5">
                            <div class="flex-1 [&>ul]:list-disc [&>ul]:pl-4 [&>ul]:space-y-1 text-red-600">
                                {{ form_errors(form.lastName) }}
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <button {{ stimulus_target('fields', 'button') }} class="mt-6 w-[180px] btn-primary cursor-not-allowed"
                                                          type="submit" disabled>
            {{ 'personalData.applyBtn'|trans({}, '_account_widget') }}
        </button>

        {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>

    {% if data.PLATFORM_MODE.value == constant('App\\Enum\\PlatformMode::LIVE').value %}
        {# Divider between sections #}
        <div class="divider my-8"></div>

        {% if data.LOGIN_WITH_UUID_ONLY.value == constant('App\\Enum\\OperationMode::OFF').value %}
            {# Form Password Section #}
            {% set has_current_pass_errors = formPassword.password.vars.errors|length > 0 %}
            {% set has_new_pass_errors = formPassword.newPassword.vars.errors|length > 0 %}
            {% set has_confirm_pass_errors = formPassword.confirmPassword.vars.errors|length > 0 %}
            {% set has_password_errors = has_current_pass_errors or has_new_pass_errors or has_confirm_pass_errors or formPassword.vars.errors|length > 0 %}

            <div {{ stimulus_controller('fields') }}>
                <h1 class="text-lg mb-8 mt-10">{{ 'changePassword.title'|trans({}, '_account_widget') }}</h1>

                {{ form_start(formPassword, {action: path('app_landing_account_user')}) }}

                <div class="flex flex-col gap-y-6">
                    <div class="flex flex-col gap-x-6 gap-y-8">
                        <div class="flex flex-col lg:flex-row gap-x-6 gap-y-8">
                            {# Current Password #}
                            <div class="relative w-full">
                                {{ form_label(formPassword.password, 'changePassword.current'|trans({}, '_account_widget'), {label_attr: {class: 'form-label'}}) }}
                                {{ form_widget(formPassword.password, {attr: {
                                    class: 'form-widget ' ~ (has_current_pass_errors ? '!border-red-500 focus:!ring-red-500 focus:!border-red-500' : ''),
                                    'data-fields-target': 'input',
                                    'data-action': 'fields#input_changed',
                                }}) }}
                            </div>

                            <div class="hidden lg:flex w-full"></div>
                        </div>

                        <div class="flex flex-col lg:flex-row gap-x-6 gap-y-8">
                            {# New Password #}
                            <div class="relative w-full">
                                {{ form_label(formPassword.newPassword, 'changePassword.new'|trans({}, '_account_widget'), {label_attr: {class: 'form-label'}}) }}
                                {{ form_widget(formPassword.newPassword, {attr: {
                                    class: 'form-widget ' ~ (has_new_pass_errors ? '!border-red-500 focus:!ring-red-500 focus:!border-red-500' : ''),
                                    minlength: 7,
                                    'data-fields-target': 'input',
                                    'data-action': 'fields#input_changed',
                                }}) }}
                            </div>

                            {# Confirm Password #}
                            <div class="relative w-full">
                                {{ form_label(formPassword.confirmPassword, 'changePassword.confirm'|trans({}, '_account_widget'), {label_attr: {class: 'form-label'}}) }}
                                {{ form_widget(formPassword.confirmPassword, {attr: {
                                    class: 'form-widget ' ~ (has_confirm_pass_errors ? '!border-red-500 focus:!ring-red-500 focus:!border-red-500' : ''),
                                    minlength: 7,
                                    'data-fields-target': 'input',
                                    'data-action': 'fields#input_changed',
                                }}) }}
                            </div>
                        </div>
                    </div>

                    {# Password Form Errors #}
                    {% if has_password_errors %}
                        <div class="w-full text-xs font-medium text-red-700 bg-red-50 border border-red-200 rounded-lg p-3.5 flex flex-col gap-3 shadow-sm">
                            {% if formPassword.vars.errors|length > 0 %}
                                <div class="flex items-start gap-2.5">
                                    <div class="flex-1 [&>ul]:list-disc [&>ul]:pl-4 [&>ul]:space-y-1 text-red-600">
                                        {{ form_errors(formPassword) }}
                                    </div>
                                </div>
                            {% endif %}
                            {% if has_current_pass_errors %}
                                <div class="flex items-start gap-2.5">
                                    <div class="flex-1 [&>ul]:list-disc [&>ul]:pl-4 [&>ul]:space-y-1 text-red-600">
                                        {{ form_errors(formPassword.password) }}
                                    </div>
                                </div>
                            {% endif %}
                            {% if has_new_pass_errors %}
                                <div class="flex items-start gap-2.5">
                                    <div class="flex-1 [&>ul]:list-disc [&>ul]:pl-4 [&>ul]:space-y-1 text-red-600">
                                        {{ form_errors(formPassword.newPassword) }}
                                    </div>
                                </div>
                            {% endif %}
                            {% if has_confirm_pass_errors %}
                                <div class="flex items-start gap-2.5">
                                    <div class="flex-1 [&>ul]:list-disc [&>ul]:pl-4 [&>ul]:space-y-1 text-red-600">
                                        {{ form_errors(formPassword.confirmPassword) }}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>

                {# Turnstile Checker #}
                {% if data.TURNSTILE_CHECKER.value == constant('App\\Enum\\OperationMode::ON').value %}
                    <div class="ml-3 mt-5">
                        {{ form_widget(formPassword.security) }}
                    </div>
                {% endif %}

                <button {{ stimulus_target('fields', 'button') }}
                        class="mt-6 w-[180px] btn-primary cursor-not-allowed"
                        type="submit" disabled>
                    {{ 'changePassword.changeBtn'|trans({}, '_account_widget') }}
                </button>

                {{ form_rest(formPassword) }}
                {{ form_end(formPassword) }}
            </div>
        {% endif %}
    {% endif %}

    {% if data.PLATFORM_MODE.value == constant('App\\Enum\\PlatformMode::LIVE').value %}
        {# Divider between sections #}
        <div class="divider my-8"></div>
        {% if data.LOGIN_WITH_UUID_ONLY.value == constant('App\\Enum\\OperationMode::OFF').value or
            user.userExternalAuths[0].provider != constant('App\\Enum\\UserProvider::PORTAL_ACCOUNT').value %}

            <h1 class="text-lg mb-8 mt-10">
                {{ 'twoFactorAuth.title'|trans({}, '_account_widget') }}
            </h1>

            <div class="grid {% if user.twoFAtype != constant('App\\Enum\\UserTwoFactorAuthenticationStatus::DISABLED').value %}grid-cols-2{% else %}grid-cols-1{% endif %} space-x-2">
                <a href="{{ path('app_configure2FA') }}" class="btn-secondary md:text-base text-sm">
                    {{ 'twoFactorAuth.configure'|trans({}, '_account_widget') }}
                </a>
                {% if user.twoFAtype != constant('App\\Enum\\UserTwoFactorAuthenticationStatus::DISABLED').value %}
                    <a href="{{ path('app_disable2FA', {context: context}) }}" class="btn-logout">
                        {{ 'twoFactorAuth.disable'|trans({}, '_account_widget') }}
                    </a>
                {% endif %}
            </div>

        {% endif %}
    {% endif %}

    {# Revoke Account Profile Section #}
    {% set has_revoke_errors = formRevokeProfiles.vars.errors|length > 0 %}
    <div {{ stimulus_controller('alert') }}>
        {# Divider between sections #}
        <div class="divider my-8"></div>

        <h1 class="text-lg mb-8 mt-10">
            {{ 'profileData.title'|trans({}, '_account_widget') }}
        </h1>

        <div class="grid grid-cols-1 space-y-4">
            {{ form_start(formRevokeProfiles, {
                action: path('app_landing_account_user'),
                attr: {
                    'data-controller': 'alert',
                    'data-alert-target': 'form',
                },
            }) }}

            {% if has_revoke_errors %}
                <div class="mb-4 w-full text-xs font-medium text-red-700 bg-red-50 border border-red-200 rounded-lg p-3.5 flex flex-col gap-3 shadow-sm">
                    <div class="flex items-start gap-2.5">
                        <div class="flex-1 [&>ul]:list-disc [&>ul]:pl-4 [&>ul]:space-y-1 text-red-600">
                            {{ form_errors(formRevokeProfiles) }}
                        </div>
                    </div>
                </div>
            {% endif %}

            {% set userUUID = app.user.uuid %}

            {% if user.userExternalAuths|length > 0 %}
                {% for auth in user.userExternalAuths %}
                    {% if auth.provider == constant('App\\Enum\\UserProvider::SAML').value %}
                        {% set userUUID = auth.providerId %}
                    {% endif %}
                {% endfor %}
            {% endif %}

            <button class="btn-logout w-full"
                    type="submit"
                    data-action="alert#revoke_profiles"
                    data-alert-target="button"
                    data-user-uuid="{{ userUUID }}"
                    data-user-actions-confirm-revoke="{{ 'profileData.confirm_revoke'|trans({'%uuid%': userUUID}, '_account_widget') }}">
                {{ 'profileData.revokeProfiles'|trans({}, '_account_widget') }}
            </button>

            {{ form_rest(formRevokeProfiles) }}
            {{ form_end(formRevokeProfiles) }}
        </div>
    </div>

    {% if data.PLATFORM_MODE.value == constant('App\\Enum\\PlatformMode::LIVE').value %}
        {# Divider between sections #}
        <div class="divider my-8"></div>

        {# Additional Option: Danger Zone for Account Deletion #}
        {% if user.email is not null or user.phoneNumber is not null %}
            {% if not is_granted(constant('App\\Enum\\AdminRoleType::ROLE_ADMIN').value) %}
                <h1 class="text-lg mb-8 mt-10 !text-red-600 font-bold uppercase">
                    {{ 'dangerZone.title'|trans({}, '_account_widget') }}
                </h1>
                <div class="grid grid-cols-1 space-y-4">
                    {% for auth in user.userExternalAuths %}
                        {% if auth.provider != constant('App\\Enum\\UserProvider::PORTAL_ACCOUNT').value %}
                            <a href="{{ path('app_user_account_deletion_external') }}" class="btn-logout"
                               onclick="return confirm('{{ 'dangerZone.deleteAccountWarningMessage'|trans({}, '_account_widget') }}')">
                                {{ 'dangerZone.deleteAccount'|trans({}, '_account_widget') }}
                            </a>
                        {% else %}
                            <a href="{{ path('app_user_account_deletion_local') }}" class="btn-logout"
                               onclick="return confirm('{{ 'dangerZone.deleteAccountWarningMessageLocal'|trans({}, '_account_widget') }}')">
                                {{ 'dangerZone.deleteAccount'|trans({}, '_account_widget') }}
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}
    {% endif %}
</div>
