{#
Cookie consent (EEA visitors only, see landing/base.html.twig).
The pieces live in landing/shared/cookies/:
  - _banner_bar.html.twig          consent bar (accept / reject / settings)
  - _preferences_modal.html.twig   preferences modal
      - _necessary_cookies.html.twig    strictly necessary cookies (depend on CAPTCHA provider / SAML)
      - _manageable_cookies.html.twig   optional cookies with a toggle
      - _cookie_item.html.twig          one declared cookie
  - _manage_button.html.twig       reopens the modal after a choice was made
#}
<div {{ stimulus_controller('cookie') }}>
    <div class="flex items-center justify-center relative">
        {{ include('landing/shared/cookies/_banner_bar.html.twig') }}
        {{ include('landing/shared/cookies/_preferences_modal.html.twig') }}
    </div>

    {{ include('landing/shared/cookies/_manage_button.html.twig') }}
    <div class="h-24 w-full" aria-hidden="true"></div>
</div>
