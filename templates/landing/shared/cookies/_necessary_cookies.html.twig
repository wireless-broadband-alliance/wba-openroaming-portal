{#
Strictly necessary cookies. Only cookies the portal really sets are declared, and the
provider-specific ones only when that feature is active.

When a cookie is added or removed in the code, update this list and the `_cookie_banner`
translations (title, description and duration) in every language.
#}
{% set captchaProvider = captcha_provider() %}
{% set isSamlEnabled = (data.AUTH_METHOD_SAML_ENABLED.value ?? 'false') == 'true' %}

{% set necessaryCookies = [
    {key: 'sessionCookie', names: 'PHPSESSID'},
    {key: 'csrfToken', names: '__Host-csrf-token_*'},
    {key: 'consentCookie', names: 'cookies_accepted, cookie_preferences'},
] %}

{# Set only while a SAML user confirms the deletion of their account (UserAccountDeletionController) #}
{% if isSamlEnabled %}
    {% set necessaryCookies = necessaryCookies|merge([
        {key: 'samlReauthCookie', names: 'previousLoggedID'},
    ]) %}
{% endif %}

{# Set by Google on www.google.com when reCAPTCHA v3 runs #}
{% if captchaProvider == constant('App\\Enum\\CaptchaProviderEnum::RECAPTCHA3').value %}
    {% set necessaryCookies = necessaryCookies|merge([{
        key: 'recaptchaCookie',
        names: '_GRECAPTCHA',
        controllerLabel: 'Google reCAPTCHA',
        controllerUrl: 'https://www.google.com/recaptcha/about/',
        privacyUrl: 'https://policies.google.com/privacy',
        external: true,
    }]) %}
{% endif %}

{# Cloudflare security cookies that may be set on challenges.cloudflare.com while Turnstile runs #}
{% if captchaProvider == constant('App\\Enum\\CaptchaProviderEnum::TURNSTILE').value %}
    {% set necessaryCookies = necessaryCookies|merge([{
        key: 'turnstileCookie',
        names: '__cf_bm, cf_clearance',
        controllerLabel: 'Cloudflare Turnstile',
        controllerUrl: 'https://www.cloudflare.com/application-services/products/turnstile/',
        privacyUrl: 'https://www.cloudflare.com/turnstile-privacy-policy/',
        external: true,
    }]) %}
{% endif %}

<div class="flex flex-col space-y-3">
    <h3 class="text-lg font-semibold">{{ 'subTitle'|trans({}, '_cookie_banner') }}</h3>
    <p class="text-sm">
        {{ 'essentialCookiesText'|trans({}, '_cookie_banner') }}
    </p>
    <ul class="text-sm space-y-4">
        {% for cookie in necessaryCookies %}
            {{ include('landing/shared/cookies/_cookie_item.html.twig', cookie, with_context: false) }}
        {% endfor %}
    </ul>
</div>
