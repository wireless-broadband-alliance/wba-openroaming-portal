{#
========================================================================================
DO NOT INCLUDE THIS TEMPLATE DIRECTLY!
========================================================================================
This partial is designed to be managed and rendered dynamically by the Twig extension.
To use CAPTCHA in the forms, use the dedicated Twig function:

    {{ render_captcha(form) }}  OR  {{ render_captcha(form.captcha) }}
========================================================================================
#}

<div class="ml-3 mt-5">
    {{ form_widget(field) }}

    {# Dynamic UI message container for client-side feedback #}
    <div id="captcha-ui-status" class="text-sm hidden mt-1"></div>

    {% if provider == constant('App\\Enum\\CaptchaProviderEnum::TURNSTILE').value %}
        <div class="cf-turnstile"
             data-sitekey="{{ siteKey }}"
             data-action="login"
             data-theme="light"
             data-callback="onTurnstileSuccess"
             data-error-callback="onTurnstileError"></div>
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

        {% elseif provider == constant('App\\Enum\\CaptchaProviderEnum::RECAPTCHA3').value %}
        <script src="https://www.google.com/recaptcha/api.js?render={{ siteKey }}"></script>
    {% endif %}

    <div class="text-red-500">
        {{ form_errors(field) }}
    </div>
</div>
