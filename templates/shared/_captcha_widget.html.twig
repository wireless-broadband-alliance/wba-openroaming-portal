{#
========================================================================================
DO NOT INCLUDE THIS TEMPLATE DIRECTLY!
========================================================================================
This partial is designed to be managed and rendered dynamically by the Twig extension.
To use CAPTCHA in the forms, use the dedicated Twig function:

    {{ render_captcha(form) }}  OR  {{ render_captcha(form.captcha) }}
========================================================================================

The action comes from CaptchaType's `captcha_action` option, or from the second argument of
render_captcha() for forms with a plain hidden field: {{ render_captcha(form, 'login') }}.
The server only accepts tokens created for that action (see App\Enum\CaptchaAction).

`data-live-ignore` (with a stable id) is required: most forms are rendered inside Live
Components, and a re-render would otherwise remove the Turnstile iframe and its
`cf-turnstile-response` input, posting the form without a CAPTCHA token.
#}

<div class="ml-3 mt-5">
    <div id="captcha-{{ fieldId }}"
         data-live-ignore
            {{ stimulus_controller('captcha', {
                provider: provider,
                siteKey: siteKey,
                fieldId: fieldId,
                action: captchaAction,
            }) }}>
        {{ form_widget(field) }}

        {% if provider == constant('App\\Enum\\CaptchaProviderEnum::TURNSTILE').value %}
            <div {{ stimulus_target('captcha', 'widget') }}></div>
        {% endif %}

        {# Client-side feedback (token pending / provider failed to load) #}
        <div {{ stimulus_target('captcha', 'status') }}
                class="text-sm text-red-500 hidden mt-1"
                role="status"
                aria-live="polite"></div>
    </div>

    {# Server-side errors stay outside the ignored wrapper so Live re-renders can update them #}
    <div class="text-red-500">
        {{ form_errors(field) }}
    </div>
</div>
