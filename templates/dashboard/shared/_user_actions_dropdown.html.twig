{# Expects: user, isAdmin, delete_users, formRevokeProfiles, userExternalAuths #}
{% set canWrite = isAdmin
    ? is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::ADMIN_MANAGEMENT_WRITE'))
    : is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::USERS_MANAGEMENT_WRITE')) %}

{% set canRead = isAdmin
    ? is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::ADMIN_MANAGEMENT_READ'))
    : is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::USERS_MANAGEMENT_READ')) %}

{# Shared row styling: consistent padding/size, background+text hover for stronger affordance,
   and a visible focus ring for keyboard users #}
{% set itemClass = 'flex flex-row items-center px-3 py-2 rounded-md duration-100 cursor-pointer hover:bg-gray-50 hover:text-lightGreen focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lightGreen/50' %}
{% set dangerItemClass = 'flex flex-row items-center px-3 py-2 rounded-md duration-100 cursor-pointer hover:bg-red-50 hover:text-red-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400/50' %}

<ul class="p-2 text-gray-700 gap-y-1 w-64">

    {% if showMoreDetails is not defined or showMoreDetails %}
        <li>
            <a href="{{ path('admin_dashboard_user_show', {id: user.id}) }}"
               class="{{ itemClass }}">
                <twig:ux:icon name="wba:user-account" class="w-5 h-5 mr-3 shrink-0 fill-none stroke-current" />
                {{ 'moreDetails'|trans({}, '_user') }}
            </a>
        </li>
    {% endif %}

    {% if canWrite %}
        <li>
            <hr class="my-1 border-gray-100">
        </li>

        <li>
            <a href="{{ path('admin_dashboard_user_edit', {id: user.id}) }}"
               class="{{ itemClass }}">
                <twig:ux:icon name="wba:pencil-edit" class="w-5 h-5 mr-3 shrink-0 fill-none stroke-current" />
                {{ 'edit'|trans({}, '_user') }}
            </a>
        </li>

        <li>
            <a href="{{ path('admin_dashboard_user_reset_password', {id: user.id}) }}"
               class="{{ itemClass }}">
                <twig:ux:icon name="wba:lock-outline" class="w-5 h-5 mr-3 shrink-0 fill-current stroke-none" />
                {{ 'resetPassword'|trans({}, '_user') }}
            </a>
        </li>

        <li>
            <hr class="my-1 border-gray-100">
        </li>

        {% if delete_users === true %}
            <li {{ stimulus_controller('alert') }}>
                <form action="{{ path('admin_dashboard_user_delete', {id: user.id}) }}"
                      method="post" {{ stimulus_target('alert', 'form') }}>
                    <input type="hidden" name="_method" value="DELETE">
                    <a href="javascript:void(0)"
                       data-user-id="{{ user.id }}"
                       data-user-uuid="{{ user.uuid }}"
                       data-user-actions-confirm-delete="{{ 'confirm_delete'|trans({'%uuid%': user.uuid}, '_user') }}"
                            {{ stimulus_action('alert', 'delete_user') }}
                            {{ stimulus_target('alert', 'button') }}
                       class="{{ dangerItemClass }} text-red-500">
                        <twig:ux:icon name="wba:trash" class="w-5 h-5 mr-3 shrink-0 fill-none stroke-current" />
                        {{ 'delete'|trans({}, '_user') }}
                    </a>
                </form>
            </li>
        {% endif %}

        <li {{ stimulus_controller('alert') }}>
            <form method="POST"
                  action="{{ path('admin_dashboard_user_revoke_profiles', {id: user.id}) }}"
                    {{ stimulus_target('alert', 'form') }}>
                {{ form_start(formRevokeProfiles) }}
                {{ form_errors(formRevokeProfiles) }}
                <input type="hidden" name="_method" value="REVOKE">
                <a href="javascript:void(0)"
                   class="{{ dangerItemClass }}"
                   data-user-actions-confirm-revoke="{{ 'confirm_revoke'|trans({'%uuid%': user.uuid}, '_user') }}"
                        {{ stimulus_action('alert', 'revoke_profiles') }}
                        {{ stimulus_target('alert', 'button') }}
                   data-user-uuid="{% if userExternalAuths[user.id] is defined %}
                       {% for auth in userExternalAuths[user.id] %}
                           {% if auth.provider == constant('App\\Enum\\UserProvider::SAML').value %}
                               {{ auth.providerId }}
                           {% else %}
                               {{ user.uuid }}
                           {% endif %}
                       {% endfor %}
                   {% endif %}">
                    <twig:ux:icon name="wba:return" class="w-5 h-5 mr-3 shrink-0 fill-none stroke-current" />
                    {{ 'revoke'|trans({}, '_user') }}
                </a>

                {{ form_rest(formRevokeProfiles) }}
                {{ form_end(formRevokeProfiles) }}
            </form>
        </li>

        {% if isAdmin and currentUser is defined and currentUser.id != user.id %}
            <li>
                <hr class="my-1 border-gray-100">
            </li>
            <li>
                <a href="{{ path('admin_dashboard_remove_user_permissions', {id: user.id}) }}"
                   class="{{ dangerItemClass }}">
                    <twig:ux:icon name="wba:cross-circle-rounded"
                                  class="w-5 h-5 mr-3 shrink-0 fill-none stroke-current" />
                    {{ 'removeAdminPerm'|trans({}, '_user') }}
                </a>
            </li>
        {% endif %}
    {% endif %}

    {% if not isAdmin and (constant('App\\Enum\\AdminRoleType::ROLE_SUPER_ADMIN').value in app.user.roles or
        is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::ADMIN_MANAGEMENT_WRITE'))) %}
        <li>
            <hr class="my-1 border-gray-100">
        </li>
        <li>
            <a href="{{ path('admin_dashboard_add_admin_permissions', {id: user.id}) }}"
               class="{{ itemClass }}">
                <twig:ux:icon name="wba:add" class="w-5 h-5 mr-3 shrink-0 fill-current stroke-none" />
                {{ 'addAdminPerm'|trans({}, '_user') }}
            </a>
        </li>
    {% endif %}
</ul>
