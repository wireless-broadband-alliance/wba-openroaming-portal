{# Table Content - AccessPoint #}
{% set itemClass = 'flex flex-row items-center px-3 py-2 rounded-md duration-100 cursor-pointer hover:bg-gray-50 hover:text-lightGreen focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lightGreen/50' %}
{% set dangerItemClass = 'flex flex-row items-center px-3 py-2 rounded-md duration-100 cursor-pointer hover:bg-red-50 hover:text-red-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400/50' %}

<tr class="font-medium">

    {# SSID #}
    <td class="p-4 pl-8">
        {{ accessPoint.entity.ssid }}
    </td>

    <td class="p-4 pl-8 text-sm font-mono">
        {% if accessPoint.lat is not null %}
            <span class="text-gray-700 block">Lat: {{ accessPoint.lat|number_format(7) }}</span>
            <span class="text-gray-400 block text-xs">Lng: {{ accessPoint.lng|number_format(7) }}</span>
        {% else %}
            <span class="text-gray-400 italic text-xs">{{ 'noData'|trans({}, '_blacklist') }}</span>
        {% endif %}
    </td>

    {# Created At #}
    <td class="p-4 pl-8">
        {% if accessPoint.entity.createdAt %}
            {{ accessPoint.entity.createdAt|date('d/m/Y H:i') }}
        {% else %}
            <span class="pill-error">{{ 'noData'|trans({}, '_blacklist') }}</span>
        {% endif %}
    </td>

    {# Updated At #}
    <td class="p-4 pl-8">
        {% if accessPoint.entity.updatedAt %}
            {{ accessPoint.entity.updatedAt|date('d/m/Y H:i') }}
        {% else %}
            <span class="pill-error">{{ 'noData'|trans({}, '_blacklist') }}</span>
        {% endif %}
    </td>

    {% if is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::MAP_WRITE')) %}
        {# Actions Buttons #}
        <td class="px-10 py-4 text-right" {{ stimulus_controller('nav-submenu') }}>
            <button type="button"
                    class="cursor-pointer p-2 rounded-lg hover:bg-gray-100 duration-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lightGreen/50"
                    {{ stimulus_action('nav-submenu', 'toggle')|stimulus_action('nav-submenu', 'lost_focus', 'focusout') }}
                    {{ stimulus_target('nav-submenu', 'button') }}>
                <twig:ux:icon name="wba:menu-dots" class="w-5 h-5 fill-current"/>
            </button>

            {# Items List Dropdown #}
            <div class="hidden bg-white divide-y divide-gray-100 rounded-lg shadow min-w-max absolute right-16 mt-2 z-16 text-left border border-gray-100"
                    {{ stimulus_target('nav-submenu', 'container') }}>
                <ul class="p-2 text-gray-700 space-y-1 w-56">
                    <li>
                        <a href="{{ path('admin_dashboard_map_accessPoint_edit', {network_id: network.id, ap_id: accessPoint.entity.id}) }}"
                           class="{{ itemClass }}">
                            <twig:ux:icon name="wba:pencil-edit"
                                          class="w-5 h-5 mr-3 shrink-0 fill-none stroke-current" />
                            {{ 'edit'|trans({}, '_network') }}
                        </a>
                    </li>

                    <li>
                        <hr class="my-1 border-gray-100">
                    </li>

                    <li>
                        <a href="{{ path('admin_dashboard_map_accessPoint_delete', {network_id: network.id, ap_id: accessPoint.entity.id}) }}"
                           class="{{ dangerItemClass }}">
                            <twig:ux:icon name="wba:trash" class="w-5 h-5 mr-3 shrink-0 fill-none stroke-current" />
                            {{ 'delete'|trans({}, '_network') }}
                        </a>
                    </li>
                </ul>
            </div>
        </td>
    {% endif %}
</tr>
