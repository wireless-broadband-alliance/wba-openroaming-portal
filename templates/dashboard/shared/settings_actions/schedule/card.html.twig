<div class="transition hover:-translate-y-1 hover:shadow bg-white rounded-md p-6 w-full" {{ stimulus_controller('card') }}>
    {# Header with title and info icon and enable toggle #}
    <div class="flex justify-between items-center">
        <h1 class="text-base md:text-lg font-medium break-words">
            {{ label }}
        </h1>

        <div class="flex items-center gap-3">
            {# Enable toggle #}
            {% if enabled_field is defined %}
                <label class="inline-flex items-center cursor-pointer">
                    {{ form_widget(enabled_field, {attr: {class: 'sr-only peer'}}) }}
                    <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4
                    peer-focus:ring-bg-lightGreen rounded-full peer peer-checked:after:translate-x-full
                    rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white
                    after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white
                    after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5
                    after:transition-all peer-checked:bg-[#68D391]"></div>
                </label>
            {% endif %}

            <img class="w-5 h-5 cursor-pointer"
                    {{ stimulus_target('card', 'button') }}
                    {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                 src="{{ asset('resources/logos/info_icon.svg') }}"
                 alt="info_icon"/>
        </div>
    </div>

    {# Description #}
    <div class="mt-2">
        {{ include('/dashboard/shared/settings_actions/_description.html.twig', {
            description: description,
        }) }}
    </div>

    <div class="{{ 'hidden' in field.advanced.vars.attr.class ? 'hidden' : '' }}">
        {{ include('dashboard/shared/settings_actions/schedule/subcard.html.twig', {
            field: field.advanced,
            field_label: 'advancedMode'|trans({}, 'schedule'),
            description: 'advancedModeDescription'|trans({}, 'schedule'),
        }) }}
    </div>

    <div class="{{ 'hidden' in field.day_of_week.vars.attr.class ? 'hidden' : '' }}">
        {{ include('dashboard/shared/settings_actions/schedule/subcard.html.twig', {
            field: field.day_of_week,
            frequency_field: field.day_of_week_frequency,
            field_label: 'dayWeek'|trans({}, 'schedule'),
            frequency_label: 'frequencyDayWeek'|trans({}, 'schedule'),
            description: 'dayWeekDescription'|trans({}, 'schedule'),
            frequency_description: 'frequencyDayWeekDescription'|trans({}, 'schedule'),
        }) }}
    </div>

    <div class="{{ 'hidden' in field.day_of_month.vars.attr.class ? 'hidden' : '' }}">
        {{ include('dashboard/shared/settings_actions/schedule/subcard.html.twig', {
            field: field.day_of_month,
            frequency_field: field.day_of_month_frequency,
            field_label: 'dayMonth'|trans({}, 'schedule'),
            frequency_label: 'frequencyDayMonth'|trans({}, 'schedule'),
            description: 'dayMonthDescription'|trans({}, 'schedule'),
            frequency_description: 'frequencyDayMonthDescription'|trans({}, 'schedule'),
        }) }}
    </div>

    <div class="{{ 'hidden' in field.months_of_the_year.vars.attr.class ? 'hidden' : '' }}">
        {{ include('dashboard/shared/settings_actions/schedule/subcard.html.twig', {
            field: field.months_of_the_year,
            frequency_field: field.months_of_the_year_frequency,
            field_label: 'monthsYear'|trans({}, 'schedule'),
            frequency_label: 'frequencyMonthsYear'|trans({}, 'schedule'),
            description: 'monthsYearDescription'|trans({}, 'schedule'),
            frequency_description: 'frequencyMonthsYearDescription'|trans({}, 'schedule'),
        }) }}
    </div>

    <div class="{{ 'hidden' in field.time.vars.attr.class ? 'hidden' : '' }}">
        {{ include('dashboard/shared/settings_actions/schedule/subcard.html.twig', {
            field: field.time,
            field_label: 'executionTime'|trans({}, 'schedule'),
            description: 'executionTimeDescription'|trans({}, 'schedule'),
        }) }}
    </div>
    {% if field_name === 'delete_unconfirmed_users_enabled' %}
        {# USER_DELETE_TIME #}
        <div class="py-4">
            <div class="form-group" {{ stimulus_controller('card') }}
             id="TIME_INTERVAL_NOTIFICATION">
            <div class="text-sm font-semibold text-gray-700 py-1">
                {{ 'deleteUnverifiedAccounts'|trans({}, '_status') }}
            </div>

            <div class="text-xs text-gray-500 mb-1 py-2">
                {{ 'USER_DELETE_TIME'|trans({}, 'setting_descriptions') }}
            </div>
            <div class="form-group">
                {{ form_widget(field.userDeleteTime, {attr: {class: 'form-widget', autocomplete: 'off'}}) }}
            </div>
            <div class="mt-2 -mb-2 text-center text-red-500 text-base">
                {{ form_errors(field.userDeleteTime) }}
            </div>
        </div>
        </div>
    {% endif %}

    {% if field_name === 'users_when_profile_expires_enabled' %}
        {# TIME_INTERVAL_NOTIFICATION #}
        <div class="form-group" {{ stimulus_controller('card') }}
             id="TIME_INTERVAL_NOTIFICATION">
            <div class="text-sm font-semibold text-gray-700 py-1">
                {{ 'profileExpirationNotification'|trans({}, '_status') }}
            </div>

            <div class="text-xs text-gray-500 mb-1 py-2">
                {{ 'TIME_INTERVAL_NOTIFICATION'|trans({}, 'setting_descriptions') }}
            </div>
            <div class="form-group">
                {{ form_widget(field.timeIntervalNotification, {attr: {class: 'form-widget', autocomplete: 'off'}}) }}
            </div>
            <div class="mt-2 -mb-2 text-center text-red-500 text-base">
                {{ form_errors(field.timeIntervalNotification) }}
            </div>
        </div>
    {% endif %}

    {% if field_name === 'cleanup_expired_data_enabled' %}
        {# USER_RETENTION_DAYS #}
        <div class="py-4">
            <div class="form-group" {{ stimulus_controller('card') }} id="USER_RETENTION_DAYS">
                <div class="text-sm font-semibold text-gray-700 py-1">
                    {{ 'userRetentionDays'|trans({}, 'schedule') }}
                </div>

                <div class="text-xs text-gray-500 mb-1 py-2">
                    {{ 'USER_RETENTION_DAYS'|trans({}, 'setting_descriptions') }}
                </div>
                <div class="form-group">
                    {{ form_widget(field.userRetentionDays, {attr: {class: 'form-widget', autocomplete: 'off'}}) }}
                </div>
                <div class="mt-2 -mb-2 text-center text-red-500 text-base">
                    {{ form_errors(field.userRetentionDays) }}
                </div>
            </div>
        </div>

        {# OTP_EXPIRATION_HOURS #}
        <div class="py-2">
            <div class="form-group" {{ stimulus_controller('card') }} id="OTP_EXPIRATION_HOURS">
                <div class="text-sm font-semibold text-gray-700 py-1">
                    {{ 'otpExpirationHours'|trans({}, 'schedule') }}
                </div>

                <div class="text-xs text-gray-500 mb-1 py-2">
                    {{ 'OTP_EXPIRATION_HOURS'|trans({}, 'setting_descriptions') }}
                </div>
                <div class="form-group">
                    {{ form_widget(field.otpExpirationHours, {attr: {class: 'form-widget', autocomplete: 'off'}}) }}
                </div>
                <div class="mt-2 -mb-2 text-center text-red-500 text-base">
                    {{ form_errors(field.otpExpirationHours) }}
                </div>
            </div>
        </div>
    {% endif %}

</div>
