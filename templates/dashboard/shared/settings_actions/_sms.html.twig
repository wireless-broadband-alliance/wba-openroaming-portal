<twig:SMSSettingsForm
        :SMSSettingsDTO="SMSSettingsDTO"
        :data="data"
        :form="form">

    {{ form_start(form) }}
    {{ form_widget(form._token) }}

    <div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-2 p-2 z-0">

        {# DEFAULT_REGION_PHONE_INPUTS #}
        <div class="transition bg-white rounded-md p-6 w-full" {{ stimulus_controller('card') }}>
            <div class="flex flex-row justify-between">
                <div class="text-base font-medium text-center break-normal md:break-all">
                    <h1 class="text-base md:text-lg whitespace-nowrap">{{ 'defaultRegionPhoneInputs'|trans({}, '_sms') }}</h1>
                </div>
                <label class="flex items-center bg-opacity-40">
                    <img class="w-6 cursor-pointer" {{ stimulus_target('card', 'button') }} {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                         src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon"/>
                </label>
            </div>

            {{ include('/dashboard/shared/settings_actions/_description.html.twig', {description: data.DEFAULT_REGION_PHONE_INPUTS.description}) }}

            <div class="flex items-center space-x-2 mt-5">
                {{ form_widget(form.defaultRegionPhoneInputs, {attr: {class: 'form-widget-selector'}}) }}
            </div>
            <div class="mt-2 -mb-2 text-center text-red-500 text-base">
                {{ form_errors(form.defaultRegionPhoneInputs) }}
            </div>
        </div>

        {# SMS_TIME_INTERVAL_BETWEEN_REQUESTS #}
        <div class="transition bg-white rounded-md p-6 w-full" {{ stimulus_controller('card') }}
             id="SMS_TIME_INTERVAL_BETWEEN_REQUESTS">
            <div class="flex flex-row justify-between">
                <div class="text-base font-medium text-center break-normal md:break-all">
                    <h1 class="text-base md:text-lg whitespace-nowrap">{{ 'timeIntervalBetweenRequests'|trans({}, '_sms') }}</h1>
                </div>
                <label class="flex items-center bg-opacity-40">
                    <img class="w-6 cursor-pointer" {{ stimulus_target('card', 'button') }} {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                         src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon"/>
                </label>
            </div>

            {{ include('/dashboard/shared/settings_actions/_description.html.twig', {description: data.SMS_TIME_INTERVAL_BETWEEN_REQUESTS.description}) }}

            <div class="flex items-center space-x-2 mt-5">
                {{ form_widget(form.timeIntervalBetweenRequests, {attr: {class: 'form-widget', autocomplete: 'off'}}) }}
            </div>
            <div class="mt-2 -mb-2 text-center text-red-500 text-base">
                {{ form_errors(form.timeIntervalBetweenRequests) }}
            </div>
        </div>

        {# SMS_TIME_INTERVAL_TO_RESET_ATTEMPTS #}
        <div class="transition bg-white rounded-md p-6 w-full" {{ stimulus_controller('card') }}
             id="SMS_TIME_INTERVAL_TO_RESET_ATTEMPTS">
            <div class="flex flex-row justify-between">
                <div class="text-base font-medium text-center break-normal md:break-all">
                    <h1 class="text-base md:text-lg whitespace-nowrap">{{ 'timeIntervalToResetAttempts'|trans({}, '_sms') }}</h1>
                </div>
                <label class="flex items-center bg-opacity-40">
                    <img class="w-6 cursor-pointer" {{ stimulus_target('card', 'button') }} {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                         src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon"/>
                </label>
            </div>

            {{ include('/dashboard/shared/settings_actions/_description.html.twig', {description: data.SMS_TIME_INTERVAL_TO_RESET_ATTEMPTS.description}) }}

            <div class="flex items-center space-x-2 mt-5">
                {{ form_widget(form.timeIntervalToResetAttempts, {attr: {class: 'form-widget', autocomplete: 'off'}}) }}
            </div>
            <div class="mt-2 -mb-2 text-center text-red-500 text-base">
                {{ form_errors(form.timeIntervalToResetAttempts) }}
            </div>
        </div>

        {# SMS_ATTEMPTS_NUMBER #}
        <div class="transition bg-white rounded-md p-6 w-full" {{ stimulus_controller('card') }}
             id="SMS_ATTEMPTS_NUMBER">
            <div class="flex flex-row justify-between">
                <div class="text-base font-medium text-center break-normal md:break-all">
                    <h1 class="text-base md:text-lg whitespace-nowrap">{{ 'attemptsNumber'|trans({}, '_sms') }}</h1>
                </div>
                <label class="flex items-center bg-opacity-40">
                    <img class="w-6 cursor-pointer" {{ stimulus_target('card', 'button') }} {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                         src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon"/>
                </label>
            </div>

            {{ include('/dashboard/shared/settings_actions/_description.html.twig', {description: data.SMS_ATTEMPTS_NUMBER.description}) }}

            <div class="flex items-center space-x-2 mt-5">
                {{ form_widget(form.attemptsNumber, {attr: {class: 'form-widget', autocomplete: 'off'}}) }}
            </div>
            <div class="mt-2 -mb-2 text-center text-red-500 text-base">
                {{ form_errors(form.attemptsNumber) }}
            </div>
        </div>

    </div>

    <div class="mt-8 divider-solid"></div>

    {% if is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::SMS_CONFIG_WRITE')) %}
    <div class="mt-6 flex flex-row w-full justify-end items-center gap-2">
        <a href="{{ path('app_dashboard_regenerate_code_admin', {type: constant('App\\Enum\\SettingType::RADIUS').value}) }}"
           data-confirm="{{ 'resetMessage'|trans({}, 'settings_actions_general')|e('html_attr') }}"
           class="text-sm hover:text-red-600 font-bold p-2 rounded-lg transition ease-in duration-300">
            {{ 'reset'|trans({}, 'settings_actions_general') }}
        </a>

            <button type="submit" class="btn-primary"
                    onclick="return confirm('{{ 'saveChangesMessage'|trans({}, 'settings_actions_general') }}')">
                {{ 'saveChanges'|trans({}, 'settings_actions_general') }}
            </button>
        </div>
    {% endif %}

    {{ form_rest(form) }}
    {{ form_end(form, {render_rest: false}) }}
</twig:SMSSettingsForm>
