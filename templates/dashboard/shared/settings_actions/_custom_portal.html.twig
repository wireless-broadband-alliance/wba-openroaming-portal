{% set imageSettings = [
    {
        name: constant('App\\Enum\\SettingName::CUSTOMER_LOGO').value,
        displayName: 'customerLogo'|trans({}, '_custom_portal'),
        imagePath: data[constant('App\\Enum\\SettingName::CUSTOMER_LOGO').value].value
        ? asset(data[constant('App\\Enum\\SettingName::CUSTOMER_LOGO').value].value)
        : null,
    },
    {
        name: constant('App\\Enum\\SettingName::OPENROAMING_LOGO').value,
        displayName: 'openRoamingLogo'|trans({}, '_custom_portal'),
        imagePath: data[constant('App\\Enum\\SettingName::OPENROAMING_LOGO').value].value
        ? asset(data[constant('App\\Enum\\SettingName::OPENROAMING_LOGO').value].value)
        : null,
    },
    {
        name: constant('App\\Enum\\SettingName::WALLPAPER_IMAGE').value,
        displayName: 'wallpaperImage'|trans({}, '_custom_portal'),
        imagePath: data[constant('App\\Enum\\SettingName::WALLPAPER_IMAGE').value].value
        ? asset(data[constant('App\\Enum\\SettingName::WALLPAPER_IMAGE').value].value)
        : null,
    },
    {
        name: constant('App\\Enum\\SettingName::FOOTER_IMAGE').value,
        displayName: 'footerImage'|trans({}, '_custom_portal'),
        imagePath: data[constant('App\\Enum\\SettingName::FOOTER_IMAGE').value].value
        ? asset(data[constant('App\\Enum\\SettingName::FOOTER_IMAGE').value].value)
        : null,
    },
] %}

{% set textSettings = [
    {
        name: constant('App\\Enum\\SettingName::PAGE_TITLE').value,
        displayName: 'pageTitle'|trans({}, '_custom_portal'),
    },
    {
        name: constant('App\\Enum\\SettingName::CONTACT_EMAIL').value,
        displayName: 'contactEmail'|trans({}, '_custom_portal'),
    },
] %}

{% set QuillSettings = [
    {
        name: constant('App\\Enum\\SettingName::WELCOME_TEXT').value,
        displayName: 'welcomeText'|trans({}, '_custom_portal'),
    },
    {
        name: constant('App\\Enum\\SettingName::WELCOME_DESCRIPTION').value,
        displayName: 'welcomeDescription'|trans({}, '_custom_portal'),
    },
    {
        name: constant('App\\Enum\\SettingName::ADDITIONAL_LABEL').value,
        displayName: 'additionalLabel'|trans({}, '_custom_portal'),
    },
] %}

<form action="{{ path('admin_dashboard_customize', {language: language}) }}" method="post"
      enctype="multipart/form-data">
    {{ form_row(form._token) }}

    <div class="flex flex-col gap-6 z-0 justify-start">

        {# Branding Section: logos, wallpaper, footer image, and toggles #}
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-lg font-semibold text-primary">
                {{ 'branding'|trans({}, '_custom_portal') }}
            </h2>
            <p class="text-sm text-gray-500 mb-4">
                {{ 'brandingDescription'|trans({}, '_custom_portal') }}
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 gap-6">
                {% for imgSetting in imageSettings %}
                    {{ include('/dashboard/shared/_card_image.html.twig', imgSetting) }}
                {% endfor %}
            </div>

            <div class="mt-6 pt-4 border-t border-gray-100 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 gap-6">
                <div>
                    {{ include('/dashboard/shared/_card_toogle.html.twig', {
                        setting: form.CUSTOMER_LOGO_ENABLED,
                        displayName: 'showCustomerLogo'|trans({}, '_custom_portal'),
                    }) }}
                </div>
                <div class="xl:col-start-4">
                    {{ include('/dashboard/shared/_card_toogle.html.twig', {
                        setting: form.FOOTER_IMAGE_ENABLED,
                        displayName: 'showFooterImage'|trans({}, '_custom_portal'),
                    }) }}
                </div>
            </div>
        </div>

        {# Text Settings #}
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-lg font-semibold text-primary">
                {{ 'generalSettings'|trans({}, '_custom_portal') }}
            </h2>
            <p class="text-sm text-gray-500 mb-4">
                {{ 'generalSettingsDescription'|trans({}, '_custom_portal') }}
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for textSetting in textSettings %}
                    {{ include('/dashboard/shared/_card.html.twig', {...textSetting, settingType: 'text'}) }}
                {% endfor %}
            </div>
        </div>

        {# Quill (rich text) Settings #}
        <div class="bg-white rounded-lg shadow p-6">
            {# Responsive Header Layout #}
            <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4 pb-6 mb-6 border-b border-gray-100">
                <div class="flex-1">
                    <h2 class="text-lg font-semibold text-primary">
                        {{ 'pageContent'|trans({}, '_custom_portal') }}
                    </h2>
                    <p class="text-sm text-gray-500 mt-1">
                        {{ 'pageContentDescription'|trans({}, '_custom_portal') }}
                    </p>
                </div>

                {# Language selector container #}
                <div class="w-full lg:w-auto shrink-0">
                    {{ include('shared/_select_language.html.twig', {
                        currentLocale: language,
                        routeName: 'admin_dashboard_customize',
                        warningMessage: true,
                    }) }}
                </div>
            </div>

            {# Grid Items #}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for QuillSetting in QuillSettings %}
                    {{ include('/dashboard/shared/_card_quill.html.twig', QuillSetting) }}
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="mt-8 divider-solid"></div>

    {% if is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::LANDING_PAGE_CONFIG_WRITE')) %}
        <div class="mt-6 flex flex-row w-full justify-end items-center gap-2">
            <a href="{{ path('app_dashboard_regenerate_code_admin', {type: 'settingCustom'}) }}"
               data-confirm="{{ 'resetMessage'|trans({}, 'settings_actions_general')|e('html_attr') }}"
               class="text-base font-semibold hover:text-red-600 transition ease-in duration-300 p-2 rounded-lg">
                {{ 'reset'|trans({}, 'settings_actions_general') }}
            </a>

            <button type="button" class="btn-secondary flex items-center"
                    onclick="
                            event.preventDefault();
                            const form = this.closest('form');
                            const originalAction = form.getAttribute('action');

                            form.setAttribute('action', '{{ path('admin_dashboard_customize_preview', {language: language}) }}');
                            form.setAttribute('target', '_blank');

                            HTMLFormElement.prototype.submit.call(form);

                            if (originalAction) {
                            form.setAttribute('action', originalAction);
                            } else {
                            form.removeAttribute('action');
                            }
                            form.removeAttribute('target');
                            ">
                {{ 'preview'|trans({}, 'settings_actions_general') }}
            </button>

            <button type="submit" class="btn-primary"
                    onclick="return confirm('{{ 'saveChangesMessage'|trans({}, 'settings_actions_general') }}')">
                {{ 'saveChanges'|trans({}, 'settings_actions_general') }}
            </button>
        </div>
    {% endif %}
</form>
