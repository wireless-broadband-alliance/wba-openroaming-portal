<twig:IpRestrictionSettingsForm
        :ipRestrictionSettingsDTO="ipRestrictionSettingsDTO"
        :data="data"
        :form="form">

    {{ form_start(form) }}
    {{ form_widget(form._token) }}

    <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 space-y-5" {{ stimulus_controller('card') }}>

        {# CARD HEADER #}
        <div class="flex flex-row justify-between">
            <h1 class="text-base md:text-lg font-medium whitespace-nowrap">
                {{ 'allowedIps'|trans({}, '_ip_restriction') }}
            </h1>

            <label class="flex items-center bg-opacity-40">
                <img class="w-6 cursor-pointer"
                        {{ stimulus_target('card', 'button') }}
                        {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                     src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon" />
            </label>
        </div>

        {# DESCRIPTION FETCHED FROM $data.ADMIN_ALLOWED_IPS #}
        {{ include('/dashboard/shared/settings_actions/_description.html.twig', {
            description: data.ADMIN_ALLOWED_IPS.description ?? ('ADMIN_ALLOWED_IPS'|trans({}, 'setting_descriptions')),
        }) }}

        {# ADD ITEM BUTTON #}
        <button type="button"
                class="mt-6 px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition"
                data-action="live#action"
                data-live-action-param="addCollectionItem"
                data-live-name-param="{{ form.allowedIps.vars.full_name }}">
            {{ 'addIp'|trans({}, '_ip_restriction') }}
        </button>

        {# LIVE COLLECTION LIST #}
        <div class="space-y-3">
            {% for key, ipField in form.allowedIps %}
                <div class="flex items-start gap-2 mt-3">
                    <div class="flex-1 min-w-0 flex flex-col">
                        {{ form_widget(ipField, {attr: {class: 'form-widget', autocomplete: 'off'}}) }}
                        <div class="text-red-500 text-sm mt-1">{{ form_errors(ipField) }}</div>
                    </div>

                    <button type="button"
                            class="w-10 h-10 min-w-10 shrink-0 flex items-center justify-center bg-red-500 text-white rounded-md hover:bg-red-600 transition"
                            aria-label="{{ 'delete'|trans({}, 'settings_actions_general') }}"
                            data-action="live#action"
                            data-live-action-param="removeCollectionItem"
                            data-live-name-param="{{ form.allowedIps.vars.full_name }}"
                            data-live-index-param="{{ key }}">
                        <twig:ux:icon name="wba:cross-circle-rounded" class="w-5 h-5 fill-current shrink-0" />
                    </button>
                </div>
            {% else %}
                <p class="text-sm text-gray-500 py-2 italic">
                    {{ 'noAllowedIps'|trans({}, '_ip_restriction') }}
                </p>
            {% endfor %}
        </div>

        <div class="text-red-500 text-sm mt-1 font-medium">
            {{ form_errors(form.allowedIps) }}
        </div>
    </div>

    {# --- INFO BANNER --- #}
    <div class="mt-4 p-2 text-base font-semibold w-full">
        <div class="toast-warning-dashboard" role="alert">
            <twig:ux:icon name="wba:info" class="w-10 md:w-5 h-10 md:h-5 inline mr-3 fill-current shrink-0" />

            <span class="font-medium">
                {{ 'ipRestrictionInfoMessage'|trans({}, '_ip_restriction') }}
            </span>
        </div>
    </div>

    <div class="mt-8 divider-solid"></div>

    {% if is_granted(constant('App\\Enum\\AdminRoleType::ROLE_SUPER_ADMIN').value) %}
        <div class="mt-6 flex flex-row w-full justify-end items-center gap-2">
            <a href="{{ path('app_dashboard_regenerate_code_admin', {type: constant('App\\Enum\\SettingType::ADMIN_IP_RESTRICTION').value}) }}"
               data-confirm="{{ 'resetMessage'|trans({}, 'settings_actions_general')|e('html_attr') }}"
               class="text-sm hover:text-red-600 font-bold p-2 rounded-lg transition ease-in duration-300">
                {{ 'reset'|trans({}, 'settings_actions_general') }}
            </a>

            <button type="submit" class="btn-primary"
                    onclick="return confirm('{{ 'saveChangesMessage'|trans({}, 'settings_actions_general') }}')">
                {{ 'saveChanges'|trans({}, 'settings_actions_general') }}
            </button>
        </div>
    {% endif %}

    {{ form_end(form, {render_rest: false}) }}
</twig:IpRestrictionSettingsForm>
