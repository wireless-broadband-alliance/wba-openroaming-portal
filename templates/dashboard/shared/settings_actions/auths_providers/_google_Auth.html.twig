{% import '/dashboard/shared/settings_actions/auths_providers/_macros.html.twig' as macros %}

<div class="p-2">
    <h1 class="text-xl md:text-2xl font-semibold">GOOGLE</h1>
</div>

<div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-3 p-2 z-0" {{ stimulus_controller('radio-card') }}>

    {# Mode (On / Off) #}
    {{ macros.radio_card(
        form.authMethodGOOGLELoginEnabled,
        'mode'|trans({}, 'auths_providers'),
        data.AUTH_METHOD_GOOGLE_LOGIN_ENABLED.description
    ) }}

    {# Label Input #}
    {{ macros.input_card(
        form.authMethodGOOGLELoginLabel,
        'label'|trans({}, 'auths_providers'),
        data.AUTH_METHOD_GOOGLE_LOGIN_LABEL.description,
        'dto.authMethodGOOGLELoginLabel'
    ) }}

    {# Description Input #}
    {{ macros.input_card(
        form.authMethodGOOGLELoginDescription,
        'description'|trans({}, 'auths_providers'),
        data.AUTH_METHOD_GOOGLE_LOGIN_DESCRIPTION.description,
        'dto.authMethodGOOGLELoginDescription'
    ) }}

    {# Google Valid Domains Input #}
    {{ macros.input_card(
        form.validDomainsGOOGLELogin,
        'googleDomains'|trans({}, 'auths_providers'),
        data.VALID_DOMAINS_GOOGLE_LOGIN.description,
        'dto.validDomainsGOOGLELogin'
    ) }}

    {# Profile Limit Date Card #}
    <div class="transition hover:-translate-y-1 hover:shadow bg-white rounded-md p-6 w-full" {{ stimulus_target('radio-card', 'card') }} {{ stimulus_controller('card') }}>
        <div class="flex flex-row justify-between">
            <h2 class="text-base md:text-lg font-semibold whitespace-nowrap">{{ 'profileLimitDate'|trans({}, 'auths_providers') }}</h2>
            <label class="flex items-center bg-opacity-40">
                <img class="w-6 cursor-pointer" {{ stimulus_target('card', 'button') }}
                        {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                     src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon"/>
            </label>
        </div>

        {{ include('/dashboard/shared/settings_actions/_description.html.twig', {description: data.PROFILE_LIMIT_DATE_GOOGLE.description}) }}

        <div class="flex items-center space-x-2 mt-5"
             data-controller="certificate-limit"
             data-certificate-limit-profile-limit-date-value='{{ profileLimitDate }}'>
            {{ form_widget(form.profileLimitDateGOOGLE, {
                attr: {
                    class: 'form-widget',
                    'data-certificate-limit-target': 'input',
                    'data-radio-card-target': 'input',
                },
            }) }}
            {% set isSuperAdmin = constant('App\\Enum\\AdminRoleType::ROLE_SUPER_ADMIN').value in user.roles %}
            {% if isSuperAdmin or is_granted(constant('App\\Security\\Voter\\UserAuthenticationVoter::AUTHENTICATION_METHODS_WRITE')) %}
                <button type="button" class="btn-cert-date"
                        data-certificate-limit-target="button"
                        data-radio-card-target="button"
                        data-action="certificate-limit#updateDate">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m14 18l4-4l4 4M16 2v4m2 16v-8"/><path d="M21 11.343V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h9M3 10h18M8 2v4"/></g></svg>
                </button>
            {% endif %}
        </div>

        <div class="mt-2 -mb-2 text-center text-red-500 text-base">
            {{ form_errors(form.profileLimitDateGOOGLE) }}
        </div>
    </div>

</div>
