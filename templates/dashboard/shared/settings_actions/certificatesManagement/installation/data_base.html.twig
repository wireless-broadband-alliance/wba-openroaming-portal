{% extends 'dashboard/shared/settings_actions/certificatesManagement/installation/base.html.twig' %}

{% block title %}
    {{ 'adminPageWBA'|trans({}, '_header_admin') }}
{% endblock %}

{% block installation_content %}

    <div class="mt-6 leading-7">
        <p class="font-bold text-base sm:text-lg md:text-xl lg:text-2xl">
            {{ 'databaseTitle'|trans({}, 'data_base') }}
        </p>
        <p class="mt-3 text-sm sm:text-base md:text-lg lg:text-xl text-gray-600">
            {{ 'databaseDescription'|trans({}, 'data_base') }}
        </p>
    </div>

    <div class="my-[25px] divider"></div>

    <twig:DataBaseForm :form="form" :dbSetupDTO="formDTO">
        {{ form_start(form) }}

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            {# ================= OPENROAMING CARD ================= #}
            <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 space-y-5">
                <div class="border-b border-slate-100 pb-4">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                        {{ 'dbOpenRoamingLabel'|trans({}, 'data_base') }}
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">
                        {{ 'dbOpenRoamingDescription'|trans({}, 'data_base') }}
                    </p>
                </div>

                {# IP & Port Row #}
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div class="sm:col-span-2 flex flex-col justify-between">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">
                            {{ 'dbOpenRoamingIP'|trans({}, 'data_base') }}
                        </label>
                        <div>
                            {{ form_widget(form.dbOpenRoamingIp, {
                                attr: {
                                    class: 'form-widget',
                                    'wire:model.debounce.500ms': 'dbSetupDTO.dbOpenRoaming',
                                    placeholder: '127.0.0.1',
                                },
                            }) }}
                            <div class="text-xs text-red-500 mt-1">{{ form_errors(form.dbOpenRoamingIp) }}</div>
                        </div>
                    </div>

                    <div class="flex flex-col justify-between">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">
                            {{ 'dbOpenRoamingPort'|trans({}, 'data_base') }}
                        </label>
                        <div>
                            {{ form_widget(form.dbOpenRoamingPort, {
                                attr: {
                                    class: 'form-widget',
                                    'wire:model.debounce.500ms': 'dbSetupDTO.dbOpenRoaming',
                                    placeholder: '3306',
                                },
                            }) }}
                            <div class="text-xs text-red-500 mt-1">{{ form_errors(form.dbOpenRoamingPort) }}</div>
                        </div>
                    </div>
                </div>

                {# DB Name #}
                <div class="space-y-1">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                        {{ 'dbOpenRoamingDbName'|trans({}, 'data_base') }}
                    </label>
                    {{ form_widget(form.dbOpenRoamingDbName, {
                        attr: {
                            class: 'form-widget',
                            'wire:model.debounce.500ms': 'dbSetupDTO.dbOpenRoamingDbName',
                            placeholder: 'openroaming',
                        },
                    }) }}
                    <div class="text-xs text-red-500 mt-1">{{ form_errors(form.dbOpenRoamingDbName) }}</div>
                </div>

                {# Username & Password Row #}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-slate-100">
                    <div class="flex flex-col justify-between">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">
                            {{ 'dbOpenRoamingUserName'|trans({}, 'data_base') }}
                        </label>
                        <div>
                            {{ form_widget(form.dbOpenRoamingUserName, {
                                attr: {
                                    class: 'form-widget',
                                    'wire:model.debounce.500ms': 'dbSetupDTO.dbOpenRoaming',
                                    placeholder: 'db_user',
                                },
                            }) }}
                            <div class="text-xs text-red-500 mt-1">{{ form_errors(form.dbOpenRoamingUserName) }}</div>
                        </div>
                    </div>

                    <div class="flex flex-col justify-between">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">
                            {{ 'dbOpenRoamingPassword'|trans({}, 'data_base') }}
                        </label>
                        <div>
                            {{ form_widget(form.dbOpenRoamingPassword, {
                                attr: {
                                    class: 'form-widget',
                                    placeholder: '••••••••',
                                },
                            }) }}
                            <div class="text-xs text-red-500 mt-1">{{ form_errors(form.dbOpenRoamingPassword) }}</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ================= FREERADIUS CARD ================= #}
            <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 space-y-5">
                <div class="border-b border-slate-100 pb-4">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                        {{ 'dbFreeradiusLabel'|trans({}, 'data_base') }}
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">
                        {{ 'dbFreeradiusDescription'|trans({}, 'data_base') }}
                    </p>
                </div>

                {# IP & Port Row #}
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div class="sm:col-span-2 flex flex-col justify-between">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">
                            {{ 'dbFreeradiusIP'|trans({}, 'data_base') }}
                        </label>
                        <div>
                            {{ form_widget(form.dbFreeradiusIp, {
                                attr: {
                                    class: 'form-widget',
                                    'wire:model.debounce.500ms': 'dbSetupDTO.dbFreeradius',
                                    placeholder: '127.0.0.1',
                                },
                            }) }}
                            <div class="text-xs text-red-500 mt-1">{{ form_errors(form.dbFreeradiusIp) }}</div>
                        </div>
                    </div>

                    <div class="flex flex-col justify-between">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">
                            {{ 'dbFreeradiusPort'|trans({}, 'data_base') }}
                        </label>
                        <div>
                            {{ form_widget(form.dbFreeradiusPort, {
                                attr: {
                                    class: 'form-widget',
                                    'wire:model.debounce.500ms': 'dbSetupDTO.dbFreeradius',
                                    placeholder: '3306',
                                },
                            }) }}
                            <div class="text-xs text-red-500 mt-1">{{ form_errors(form.dbFreeradiusPort) }}</div>
                        </div>
                    </div>
                </div>

                {# DB Name #}
                <div class="space-y-1">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                        {{ 'dbFreeradiusDbName'|trans({}, 'data_base') }}
                    </label>
                    {{ form_widget(form.dbFreeradiusDbName, {
                        attr: {
                            class: 'form-widget',
                            'wire:model.debounce.500ms': 'dbSetupDTO.dbFreeradiusDbName',
                            placeholder: 'radius',
                        },
                    }) }}
                    <div class="text-xs text-red-500 mt-1">{{ form_errors(form.dbFreeradiusDbName) }}</div>
                </div>

                {# Username & Password Row #}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-slate-100">
                    <div class="flex flex-col justify-between">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">
                            {{ 'dbFreeradiusUserName'|trans({}, 'data_base') }}
                        </label>
                        <div>
                            {{ form_widget(form.dbFreeradiusUserName, {
                                attr: {
                                    class: 'form-widget',
                                    'wire:model.debounce.500ms': 'dbSetupDTO.dbFreeradius',
                                    placeholder: 'db_user',
                                },
                            }) }}
                            <div class="text-xs text-red-500 mt-1">{{ form_errors(form.dbFreeradiusUserName) }}</div>
                        </div>
                    </div>

                    <div class="flex flex-col justify-between">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1">
                            {{ 'dbFreeradiusPassword'|trans({}, 'data_base') }}
                        </label>
                        <div>
                            {{ form_widget(form.dbFreeradiusPassword, {
                                attr: {
                                    class: 'form-widget',
                                    placeholder: '••••••••',
                                },
                            }) }}
                            <div class="text-xs text-red-500 mt-1">{{ form_errors(form.dbFreeradiusPassword) }}</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="mt-8 divider-solid"></div>

        <div class="mt-6 flex w-full justify-end items-center gap-2">
            <button type="submit" class="w-[160px] btn-primary"
                    onclick="return confirm('{{ 'saveChangesMessage'|trans({}, 'data_base') }}')">
                {{ 'databaseApplyBtn'|trans({}, 'data_base') }}
            </button>
        </div>

        {{ form_end(form) }}
    </twig:DataBaseForm>
{% endblock %}
