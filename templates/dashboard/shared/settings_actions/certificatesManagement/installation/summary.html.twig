{% extends 'dashboard/shared/settings_actions/certificatesManagement/installation/base.html.twig' %}

{% block title %}
    {{ 'adminPageWBA'|trans({}, '_header_admin') }}
{% endblock %}

{% block installation_content %}

    <div class="mt-6 leading-7">
        <p class="font-bold text-base sm:text-lg md:text-xl lg:text-2xl text-slate-900">
            {{ 'title'|trans({}, 'summary') }}
        </p>
        <p class="mt-3 text-sm sm:text-base md:text-lg lg:text-xl text-gray-600">
            {{ 'description'|trans({}, 'summary') }}
        </p>
    </div>

    <div class="my-[25px] divider"></div>

    {# --- Summary Cards Grid --- #}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        {# ================= OPENROAMING DB CARD ================= #}
        <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 space-y-4 flex flex-col justify-between">
            <div>
                <div class="border-b border-slate-100 pb-4 mb-4">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                        <twig:ux:icon name="wba:database" class="w-5 h-5 text-slate-600 fill-none stroke-current" />
                        {{ 'databaseOpenRoaming'|trans({}, 'summary') }}
                    </h2>
                </div>

                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                            {{ 'host'|trans({}, 'summary') }}
                        </label>
                        <div class="text-sm font-mono text-slate-800 bg-slate-50 rounded-lg px-3 py-2 border border-slate-200/60 truncate">
                            {{ Installation.dbOpenRoamingIp|default('-') }}
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                            {{ 'port'|trans({}, 'summary') }}
                        </label>
                        <div class="text-sm font-mono text-slate-800 bg-slate-50 rounded-lg px-3 py-2 border border-slate-200/60 truncate">
                            {{ Installation.dbOpenRoamingPort|default('-') }}
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                            {{ 'username'|trans({}, 'summary') }}
                        </label>
                        <div class="text-sm font-mono text-slate-800 bg-slate-50 rounded-lg px-3 py-2 border border-slate-200/60 truncate">
                            {{ Installation.dbOpenRoamingUserName|default('-') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ================= FREERADIUS DB CARD ================= #}
        <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 space-y-4 flex flex-col justify-between">
            <div>
                <div class="border-b border-slate-100 pb-4 mb-4">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                        <twig:ux:icon name="wba:hdd" class="w-5 h-5 text-slate-600 fill-none stroke-current" />
                        {{ 'databaseFreeradius'|trans({}, 'summary') }}
                    </h2>
                </div>

                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                            {{ 'host'|trans({}, 'summary') }}
                        </label>
                        <div class="text-sm font-mono text-slate-800 bg-slate-50 rounded-lg px-3 py-2 border border-slate-200/60 truncate">
                            {{ Installation.dbFreeradiusIp|default('-') }}
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                            {{ 'port'|trans({}, 'summary') }}
                        </label>
                        <div class="text-sm font-mono text-slate-800 bg-slate-50 rounded-lg px-3 py-2 border border-slate-200/60 truncate">
                            {{ Installation.dbFreeradiusPort|default('-') }}
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                            {{ 'username'|trans({}, 'summary') }}
                        </label>
                        <div class="text-sm font-mono text-slate-800 bg-slate-50 rounded-lg px-3 py-2 border border-slate-200/60 truncate">
                            {{ Installation.dbFreeradiusUserName|default('-') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ================= ADDITIONAL SETTINGS CARD ================= #}
        <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 space-y-4 flex flex-col justify-between md:col-span-2 lg:col-span-1">
            <div>
                <div class="border-b border-slate-100 pb-4 mb-4">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                        <twig:ux:icon name="wba:user-circle" class="w-5 h-5 text-slate-600 fill-none stroke-current" />
                        {{ 'additionalSettings'|trans({}, 'summary') }}
                    </h2>
                </div>

                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                            {{ 'emailAdmin'|trans({}, 'summary') }}
                        </label>
                        <div class="text-sm text-slate-800 bg-slate-50 rounded-lg px-3 py-2 border border-slate-200/60 truncate">
                            {{ Installation.emailAdmin|default('-') }}
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                            {{ 'trustedProxies'|trans({}, 'summary') }}
                        </label>
                        <div class="text-sm font-mono text-slate-800 bg-slate-50 rounded-lg px-3 py-2 border border-slate-200/60 truncate">
                            {{ Installation.trustedProxies|default('-') }}
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                            {{ 'turnstileKey'|trans({}, 'summary') }}
                        </label>
                        <div class="text-sm font-mono text-slate-800 bg-slate-50 rounded-lg px-3 py-2 border border-slate-200/60 truncate">
                            {{ Installation.turnstileKey|default('-') }}
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">
                            {{ 'turnstileSecret'|trans({}, 'summary') }}
                        </label>
                        <div class="text-sm font-mono text-slate-800 bg-slate-50 rounded-lg px-3 py-2 border border-slate-200/60 truncate">
                            {% if Installation.turnstileSecret is defined and Installation.turnstileSecret is not empty %}
                                {% if Installation.turnstileSecret|length > 4 %}
                                    ••••••••{{ Installation.turnstileSecret|slice(-4) }}
                                {% else %}
                                    {{ Installation.turnstileSecret }}
                                {% endif %}
                            {% else %}
                                -
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-8 divider-solid"></div>

    {# --- Action Buttons --- #}
    <div class="mt-6 flex w-full justify-end items-center gap-2">
        {% set SYSTEM_RESET_REQUEST = constant('App\\Enum\\SessionStatus::SYSTEM_RESET_REQUEST').value %}

        {# If there is NO system reset request OR if certificate process was already completed previously #}
        {% if not app.session.has(SYSTEM_RESET_REQUEST) or (hasCompletedCertProcess is defined and hasCompletedCertProcess) %}
            <a href="{{ path('admin_dashboard_settings_certs_installation_complete') }}"
               class="w-[160px] btn-primary flex justify-center items-center">
                {{ 'finish'|trans({}, 'summary') }}
            </a>
        {% else %}
            <a href="{{ path('admin_dashboard_settings_certs_radsecproxy_upload') }}"
               class="w-[160px] btn-primary flex justify-center items-center">
                {{ 'proceed'|trans({}, 'summary') }}
            </a>
        {% endif %}
    </div>

{% endblock %}
