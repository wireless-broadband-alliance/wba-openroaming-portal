{% extends 'dashboard/shared/settings_actions/certificatesManagement/installation/base.html.twig' %}

{% block title %}
    {{ 'adminPageWBA'|trans({}, '_header_admin') }}
{% endblock %}

{% block installation_content %}

    <div class="mt-6 leading-7">
        <p class="font-bold text-base sm:text-lg md:text-xl lg:text-2xl text-gray-900">
            {{ 'captchaTitle'|trans({}, 'captcha') }}
        </p>
        <p class="mt-2 text-sm sm:text-base text-gray-600">
            {{ 'captchaDescription'|trans({}, 'captcha') }}
        </p>
    </div>

    <div class="my-6 border-t border-gray-200"></div>

    {% if message is defined and message %}
        {{ include('shared/_toast.html.twig', {
            toast_type: 'toast-warning-dashboard',
            message: message,
        }) }}
    {% endif %}

    {% set selectedProvider = form.provider.vars.value %}

    <div data-controller="captcha-step-provider" class="flex flex-col">
        {{ form_start(form, { attr: { autocomplete: 'off' } }) }}

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            {# ================= PROVIDER SELECTION CARD ================= #}
            <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 space-y-5">
                <div class="border-b border-slate-100 pb-4">
                    <h2 class="text-lg font-bold text-slate-900">
                        {{ 'captchaProviderLabel'|trans({}, 'captcha') }}
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">
                        {{ 'captchaProviderDescription'|trans({}, 'captcha') }}
                    </p>
                </div>

                <div class="space-y-1">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-2">
                        {{ 'selectProvider'|trans({}, 'captcha') }}
                    </label>

                    {{ form_widget(form.provider, {
                        attr: {
                            class: 'form-widget',
                            'data-captcha-step-provider-target': 'select',
                            'data-action': 'change->captcha-step-provider#update',
                        },
                    }) }}
                    {% if form_errors(form.provider) %}
                        <div class="text-xs text-red-500 font-medium mt-1">
                            {{ form_errors(form.provider) }}
                        </div>
                    {% endif %}
                </div>
            </div>

            {# ================= CLOUDFLARE TURNSTILE CARD ================= #}
            <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 space-y-5 {{ selectedProvider != constant('App\\Enum\\CaptchaProviderEnum::TURNSTILE').value ? 'hidden' : '' }}"
                 data-captcha-step-provider-target="item"
                 data-captcha-step-provider-value="{{ constant('App\\Enum\\CaptchaProviderEnum::TURNSTILE').value }}"
                    {{ stimulus_controller('card') }}>

                <div class="border-b border-slate-100 pb-4 flex flex-row justify-between items-start">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                        {{ 'turnstileLabel'|trans({}, 'captcha') }}
                    </h2>

                    <label class="flex items-center cursor-pointer pt-1">
                        <img class="w-5 h-5 opacity-70 hover:opacity-100 transition"
                                {{ stimulus_target('card', 'button') }}
                                {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                             src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon" />
                    </label>
                </div>

                {{ include('/dashboard/shared/settings_actions/_description.html.twig', {
                    description: 'turnstileHelpInfo'|trans({}, 'captcha'),
                }) }}

                <div class="space-y-1">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                        {{ 'turnstileSiteKeyLabel'|trans({}, 'captcha') }}
                    </label>
                    {{ form_widget(form.turnstileKey, {
                        attr: {
                            class: 'form-widget',
                            placeholder: '0x4AAAAAAA...',
                        }
                    }) }}
                    {% if form_errors(form.turnstileKey) %}
                        <div class="text-xs text-red-500 font-medium mt-1">{{ form_errors(form.turnstileKey) }}</div>
                    {% endif %}
                </div>

                <div class="space-y-1 pt-2">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                        {{ 'turnstileSecretKeyLabel'|trans({}, 'captcha') }}
                    </label>
                    {{ form_widget(form.turnstileSecret, {
                        attr: {
                            class: 'form-widget',
                            placeholder: '0x4AAAAAAA...',
                        }
                    }) }}
                    {% if form_errors(form.turnstileSecret) %}
                        <div class="text-xs text-red-500 font-medium mt-1">{{ form_errors(form.turnstileSecret) }}</div>
                    {% endif %}
                </div>
            </div>

            {# ================= GOOGLE RECAPTCHA V3 CARD ================= #}
            <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 space-y-5 {{ selectedProvider != constant('App\\Enum\\CaptchaProviderEnum::RECAPTCHA3').value ? 'hidden' : '' }}"
                 data-captcha-step-provider-target="item"
                 data-captcha-step-provider-value="{{ constant('App\\Enum\\CaptchaProviderEnum::RECAPTCHA3').value }}"
                    {{ stimulus_controller('card') }}>

                <div class="border-b border-slate-100 pb-4 flex flex-row justify-between items-start">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                        {{ 'recaptcha3Label'|trans({}, 'captcha') }}
                    </h2>

                    <label class="flex items-center cursor-pointer pt-1">
                        <img class="w-5 h-5 opacity-70 hover:opacity-100 transition"
                                {{ stimulus_target('card', 'button') }}
                                {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                             src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon" />
                    </label>
                </div>

                {{ include('/dashboard/shared/settings_actions/_description.html.twig', {
                    description: 'recaptcha3HelpInfo'|trans({}, 'captcha'),
                }) }}

                <div class="space-y-1">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                        {{ 'recaptcha3SiteKeyLabel'|trans({}, 'captcha') }}
                    </label>
                    {{ form_widget(form.recaptcha3Key, {
                        attr: {
                            class: 'form-widget',
                            placeholder: '6Ld...',
                        }
                    }) }}
                    {% if form_errors(form.recaptcha3Key) %}
                        <div class="text-xs text-red-500 font-medium mt-1">{{ form_errors(form.recaptcha3Key) }}</div>
                    {% endif %}
                </div>

                <div class="space-y-1 pt-2">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                        {{ 'recaptcha3SecretKeyLabel'|trans({}, 'captcha') }}
                    </label>
                    {{ form_widget(form.recaptcha3Secret, {
                        attr: {
                            class: 'form-widget',
                            placeholder: '6Ld...',
                        }
                    }) }}
                    {% if form_errors(form.recaptcha3Secret) %}
                        <div class="text-xs text-red-500 font-medium mt-1">{{ form_errors(form.recaptcha3Secret) }}</div>
                    {% endif %}
                </div>
            </div>

        </div>

        <div class="my-8 border-t border-gray-200"></div>

        <div class="flex justify-end">
            <button type="submit"
                    class="px-6 py-2.5 bg-lime-600 hover:bg-lime-700 text-white font-medium text-sm rounded-lg shadow transition-all cursor-pointer"
                    onclick="return confirm('{{ 'saveChangesMessage'|trans({}, 'data_base') }}')">
                {{ 'captchaApplyBtn'|trans({}, 'captcha') }}
            </button>
        </div>

        {{ form_row(form._token) }}
        {{ form_end(form, {render_rest: false}) }}
    </div>

{% endblock %}
