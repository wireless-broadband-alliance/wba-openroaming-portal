{% extends 'dashboard/shared/settings_actions/certificatesManagement/installation/base.html.twig' %}

{% block title %}
    {{ 'adminPageWBA'|trans({}, '_header_admin') }}
{% endblock %}

{% block installation_content %}

    <div class="mt-6 leading-7">
        <p class="font-bold text-base sm:text-lg md:text-xl lg:text-2xl text-gray-900">
            {{ 'adminConfigTitle'|trans({}, 'admin_config') }}
        </p>
        <p class="mt-2 text-sm sm:text-base text-gray-600">
            {{ 'adminConfigDescription'|trans({}, 'admin_config') }}
        </p>
    </div>

    <div class="my-6 border-t border-gray-200"></div>

    {{ form_start(form, {attr: {autocomplete: 'off'}}) }}

    <div class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">

        {# --- Email Card --- #}
        <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 flex flex-col">
            <div class="min-h-[4.5rem]">
                <div class="flex flex-row justify-between items-center mb-3">
                    <h1 class="text-base font-semibold text-gray-800">
                        {{ 'emailLabel'|trans({}, 'admin_config') }}
                    </h1>
                    <label class="flex items-center">
                        <img class="w-5 h-5 cursor-pointer opacity-60 hover:opacity-100 transition-opacity"
                                {{ stimulus_target('card', 'button') }}
                                {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                             src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon" />
                    </label>
                </div>

                {{ include('/dashboard/shared/settings_actions/_description.html.twig', {
                    description: 'emailDescription'|trans({}, 'admin_config'),
                }) }}
            </div>

            <div class="space-y-2 flex-1 flex flex-col justify-start">
                {{ form_widget(form.email, {
                    attr: {
                        class: 'form-widget mt-1 block w-full rounded-md border-gray-200 p-2',
                    },
                }) }}

                <p class="text-xs text-gray-500">
                    {{ 'emailWarning'|trans({}, 'admin_config') }}
                </p>

                {% if form_errors(form.email) %}
                    <div class="text-xs text-red-500 font-medium mt-1">
                        {{ form_errors(form.email) }}
                    </div>
                {% endif %}
            </div>
        </div>

        {# --- Password Card --- #}
        <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 flex flex-col">
            <div class="min-h-[4.5rem]">
                <div class="flex flex-row justify-between items-center mb-3">
                    <h1 class="text-base font-semibold text-gray-800">
                        {{ 'passwordLabel'|trans({}, 'admin_config') }}
                    </h1>
                </div>
            </div>

            <div class="space-y-2 flex-1 flex flex-col justify-start">
                {{ form_widget(form.password, {
                    attr: {
                        class: 'form-widget mt-1 block w-full rounded-md border-gray-200 p-2',
                    },
                }) }}

                {% if form_errors(form.password) %}
                    <div class="text-xs text-red-500 font-medium mt-1">
                        {{ form_errors(form.password) }}
                    </div>
                {% endif %}
            </div>
        </div>

        {# --- Confirm Password Card --- #}
        <div class="bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 flex flex-col">
            <div class="min-h-[4.5rem]">
                <div class="flex flex-row justify-between items-center mb-3">
                    <h1 class="text-base font-semibold text-gray-800">
                        {{ 'passwordConfirmLabel'|trans({}, 'admin_config') }}
                    </h1>
                </div>
            </div>

            <div class="space-y-2 flex-1 flex flex-col justify-start">
                {{ form_widget(form.confirmPassword, {
                    attr: {
                        class: 'form-widget mt-1 block w-full rounded-md border-gray-200 p-2',
                    },
                }) }}

                {% if form_errors(form.confirmPassword) %}
                    <div class="text-xs text-red-500 font-medium mt-1">
                        {{ form_errors(form.confirmPassword) }}
                    </div>
                {% endif %}
            </div>
        </div>

    </div>

    <div class="my-8 border-t border-gray-200"></div>

    <div class="flex justify-end">
        <button type="submit"
                class="px-6 py-2.5 bg-lime-600 hover:bg-lime-700 text-white font-medium text-sm rounded-lg shadow transition-all cursor-pointer"
                onclick="return confirm('{{ 'saveChangesMessage'|trans({}, 'admin_config') }}')">
            {{ 'databaseApplyBtn'|trans({}, 'admin_config') }}
        </button>
    </div>

    {{ form_row(form._token) }}
    {{ form_end(form, {render_rest: false}) }}

{% endblock %}
