{% set steps = [
  {id: 'database', route: ['admin_dashboard_settings_certs_installation']},
  {id: 'settings', route: ['admin_dashboard_settings_certs_installation_settings']},
  {id: 'captcha', route: ['admin_dashboard_settings_certs_installation_captcha']},
  {id: 'security_txt', route: ['admin_dashboard_settings_certs_installation_security_txt']},
  {id: 'admin_credentials', route: [
    'admin_dashboard_settings_certs_installation_admin',
    'admin_dashboard_settings_certs_installation_admin_sendCode',
    'admin_dashboard_settings_certs_installation_admin_confirmation',
    'admin_dashboard_settings_certs_installation_admin_confirmation_resend',
    'admin_dashboard_settings_certs_installation_command',
  ]},
  {id: 'summary', route: ['admin_dashboard_settings_certs_installation_summary']},
] %}

{% set currentRoute = app.request.attributes.get('_route') %}
{% set currentIndex = 0 %}

{% for s in steps %}
  {% if currentRoute in s.route %}
    {% set currentIndex = loop.index0 %}
  {% endif %}
{% endfor %}

{% set totalSteps = steps|length %}
{% set progressPercent = totalSteps > 1 ? (currentIndex / (totalSteps - 1)) * 100 : 0 %}

<div class="w-full mb-8">

  {# Header Bar with Action Buttons #}
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-4 mb-8 border-b border-slate-200/80">
    <div>
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
        Step {{ currentIndex + 1 }} of {{ totalSteps }}
      </span>
    </div>

    <div class="flex items-center gap-2 sm:gap-3 w-full sm:w-auto justify-end">
      {% set SYSTEM_RESET_REQUEST = constant('App\\Enum\\SessionStatus::SYSTEM_RESET_REQUEST').value %}
      {% if not app.session.has(SYSTEM_RESET_REQUEST) %}
        {% if currentRoute != 'admin_dashboard_settings_certs_installation' %}
          <form action="{{ path('admin_dashboard_settings_certs_installation_abortProcess') }}"
                method="POST"
                onsubmit="return confirm('{{ 'confirm_abort'|trans({}, '_installation_stepper') }}');">
            <button type="submit"
                    class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-medium rounded-lg text-red-700 bg-white border border-red-200 shadow-sm hover:bg-red-50 hover:border-red-300 transition-colors">
              <twig:ux:icon name="wba:cross-circle-rounded" class="w-4 h-4 fill-current text-red-600" />
              {{ 'abort'|trans({}, '_installation_stepper') }}
            </button>
          </form>
        {% endif %}

        <a href="{{ path('admin_page') }}"
           class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-medium rounded-lg text-slate-700 bg-white border border-slate-200 shadow-sm hover:bg-slate-50 hover:border-slate-300 transition-colors">
          <twig:ux:icon name="wba:exit" class="w-4 h-4 fill-current text-slate-500" />
          {{ 'leave'|trans({}, '_installation_stepper') }}
        </a>
      {% else %}
        <a href="{{ path('app_dashboard_logout') }}"
           class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-medium rounded-lg text-red-700 bg-white border border-red-200 shadow-sm hover:bg-red-50 hover:border-red-300 transition-colors">
          <twig:ux:icon name="wba:logout" class="w-4 h-4 stroke-current fill-none text-red-600" />
          {{ 'logout'|trans({}, 'landing') }}
        </a>
      {% endif %}
    </div>
  </div>

  {# Stepper Container #}
  <div class="relative">

    {# Connecting Line Track (Spans directly across center of column 1 to column 6) #}
    <div class="hidden md:block absolute top-5 left-[8.33%] right-[8.33%] h-0.5 bg-slate-200 -z-0">
      <div class="h-full bg-primary transition-all duration-500 ease-in-out"
           style="width: {{ progressPercent }}%;"></div>
    </div>

    {# 6-Column Grid #}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-y-6 gap-x-2 relative z-10">
      {% for step in steps %}
        {% set title = ('step.' ~ step.id ~ '.title')|trans({}, '_installation_stepper') %}
        {% set description = ('step.' ~ step.id ~ '.description')|trans({}, '_installation_stepper') %}
        {% set active = currentRoute in step.route %}
        {% set completed = stages[step.id] ?? false %}

        <div class="flex flex-col items-center text-center group">

          {# Circle Badge (Static) #}
          <div class="relative bg-white rounded-full p-1">
            <div class="flex items-center justify-center w-10 h-10 rounded-full font-bold text-sm transition-all duration-200 shadow-sm
              {% if completed and not active %}
                bg-primary border-2 border-primary text-white
              {% elseif active %}
                bg-white border-2 border-primary text-primary ring-4 ring-primary/10 scale-105
              {% else %}
                bg-slate-50 border-2 border-slate-200 text-slate-400
              {% endif %}">
              {% if completed and not active %}
                <twig:ux:icon name="wba:check-rounded" class="w-5 fill-current stroke-none"/>
              {% else %}
                {{ loop.index }}
              {% endif %}
            </div>
          </div>

          {# Step Title & Description #}
          <div class="mt-2.5 flex flex-col items-center w-full px-0.5">
            <span class="text-xs font-bold leading-tight transition-colors duration-200
              {% if active %}
                text-primary
              {% elseif completed %}
                text-slate-900
              {% else %}
                text-slate-400
              {% endif %}">
              {{ title }}
            </span>

            <p class="text-[10px] leading-tight text-slate-400 mt-1 hidden xl:block line-clamp-2">
              {{ description }}
            </p>
          </div>

        </div>
      {% endfor %}
    </div>

  </div>
</div>
