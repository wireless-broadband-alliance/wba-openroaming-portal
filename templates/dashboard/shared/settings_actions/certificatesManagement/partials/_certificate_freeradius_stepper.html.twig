{% set steps = [
    {
        id: 'freeradius_upload',
        routes: [
        'admin_dashboard_settings_certs_freeradius_upload',
        'admin_dashboard_settings_certs_freeradius_auto_renew',
        'admin_dashboard_settings_certs_freeradius_auto_renew_domain',
        'admin_dashboard_settings_certs_freeradius_cloudflare_dnsChallenge',
    ],
    },
    {
        id: 'freeradius_config',
        routes: ['admin_dashboard_settings_certs_freeradius_config'],
    },
    {
        id: 'freeradius_test',
        routes: ['admin_dashboard_settings_certs_freeradius_test'],
    },
] %}

{% set currentRoute = app.request.attributes.get('_route') %}
{% set currentIndex = 0 %}

{% for s in steps %}
    {% if currentRoute in s.routes %}
        {% set currentIndex = loop.index0 %}
    {% endif %}
{% endfor %}

{% set totalSteps = steps|length %}
{% set progressPercent = totalSteps > 1 ? (currentIndex / (totalSteps - 1)) * 100 : 0 %}

{{ include('dashboard/shared/settings_actions/certificatesManagement/partials/_abort_certs.html.twig') }}
{{ include('dashboard/shared/settings_actions/certificatesManagement/partials/_freeradius_info_title.html.twig') }}

<div class="w-full mb-8">
    <div class="mb-6">
        {{ include('dashboard/shared/_info_details.html.twig', {
            info_text: 'info_text_stepper_details'|trans({}, '_certificate_stepper'),
        }) }}
    </div>

    {# Stepper Container #}
    <div class="relative">

        {# Connecting Line Track (Desktop Only - spans center of Col 1 [16.66%] to Col 3 [83.33%]) #}
        <div class="hidden md:block absolute top-5 left-[16.66%] right-[16.66%] h-0.5 bg-slate-200 -z-0">
            <div class="h-full bg-primary transition-all duration-500 ease-in-out"
                 style="width: {{ progressPercent }}%;"></div>
        </div>

        {# 3-Column Equal Grid #}
        {% set stages = processState.stages ?? {} %}

        <div class="grid grid-cols-1 md:grid-cols-3 gap-y-6 gap-x-2 relative z-10">
            {% for step in steps %}
                {% set title = ('step.' ~ step.id ~ '.title')|trans({}, '_certificate_stepper') %}
                {% set description = ('step.' ~ step.id ~ '.description')|trans({}, '_certificate_stepper') %}
                {% set active = currentRoute in step.routes %}
                {% set completed = stages[step.id] ?? false %}

                <div class="flex flex-col items-center text-center group">

                    {# Circle Badge (Static / Non-clickable) #}
                    <div class="relative bg-white rounded-full p-1">
                        <div class="flex items-center justify-center w-10 h-10 rounded-full font-bold text-sm transition-all duration-200 shadow-sm
              {% if completed and not active %}
                bg-primary border-2 border-primary text-white
              {% elseif active %}
                bg-white border-2 border-primary text-primary ring-4 ring-primary/10 scale-105
              {% else %}
                bg-slate-50 border-2 border-slate-200 text-slate-400
              {% endif %}">
                            {% if completed and not active %}
                                <twig:ux:icon name="wba:check-rounded" class="w-5 fill-current stroke-none" />
                            {% else %}
                                {{ loop.index }}
                            {% endif %}
                        </div>
                    </div>

                    {# Step Title & Description #}
                    <div class="mt-2.5 flex flex-col items-center w-full px-2">
            <span class="text-xs font-bold leading-tight transition-colors duration-200
              {% if active %}
                text-primary
              {% elseif completed %}
                text-slate-900
              {% else %}
                text-slate-400
              {% endif %}">
              {{ title }}
            </span>

                        <p class="text-[10px] leading-tight text-slate-400 mt-1 hidden md:block line-clamp-2">
                            {{ description }}
                        </p>
                    </div>

                </div>
            {% endfor %}
        </div>

    </div>
</div>
