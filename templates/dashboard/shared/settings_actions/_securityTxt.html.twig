<twig:SecurityTxtSettingsForm
        :securityTxtSettingsDTO="securityTxtSettingsDTO"
        :data="data"
        :form="form">

    {{ form_start(form) }}
    {{ form_widget(form._token) }}

    <div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-3 p-2 z-0">

        {# SECURITY_CONTACT #}
        <div class="transition bg-white rounded-md p-6 w-full" {{ stimulus_controller('card') }}>
            <div class="flex flex-row justify-between">
                <div class="text-base font-medium text-center break-normal md:break-all">
                    <h1 class="text-base md:text-lg whitespace-nowrap">{{ 'securityContact'|trans({}, '_securityTxt') }}</h1>
                </div>
                <label class="flex items-center bg-opacity-40">
                    <img class="w-6 cursor-pointer" {{ stimulus_target('card', 'button') }} {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                         src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon"/>
                </label>
            </div>
            {{ include('/dashboard/shared/settings_actions/_description.html.twig', {description: data.SECURITY_CONTACT.description}) }}
            <div class="flex items-center space-x-2 mt-5">
                {{ form_widget(form.securityContact, {attr: {class: 'form-widget', autocomplete: 'off'}}) }}
            </div>
            <div class="mt-2 -mb-2 text-center text-red-500 text-base">
                {{ form_errors(form.securityContact) }}
            </div>
        </div>

        {# SECURITY_EXPIRES #}
        <div class="transition bg-white rounded-md p-6 w-full" {{ stimulus_controller('card') }}>
            <div class="flex flex-row justify-between">
                <div class="text-base font-medium text-center break-normal md:break-all">
                    <h1 class="text-base md:text-lg whitespace-nowrap">{{ 'securityExpires'|trans({}, '_securityTxt') }}</h1>
                </div>
                <label class="flex items-center bg-opacity-40">
                    <img class="w-6 cursor-pointer" {{ stimulus_target('card', 'button') }} {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                         src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon"/>
                </label>
            </div>
            {{ include('/dashboard/shared/settings_actions/_description.html.twig', {description: data.SECURITY_EXPIRES.description}) }}
            <div class="flex items-center space-x-2 mt-5">
                {{ include('dashboard/shared/_date_picker.html.twig', {
                    field: form.securityExpires,
                    controller: 'date-picker-security-txt',
                }) }}
            </div>
        </div>

        {# SECURITY_PGP_FINGERPRINT #}
        <div class="transition bg-white rounded-md p-6 w-full" {{ stimulus_controller('card') }}>
            <div class="flex flex-row justify-between">
                <div class="text-base font-medium text-center break-normal md:break-all">
                    <h1 class="text-base md:text-lg whitespace-nowrap">{{ 'securityPgpFingerprint'|trans({}, '_securityTxt') }}</h1>
                </div>
                <label class="flex items-center bg-opacity-40">
                    <img class="w-6 cursor-pointer" {{ stimulus_target('card', 'button') }} {{ stimulus_action('card', 'show_info', 'mouseover')|stimulus_action('card', 'hide_info', 'mouseout') }}
                         src="{{ asset('resources/logos/info_icon.svg') }}" alt="info_icon"/>
                </label>
            </div>
            {{ include('/dashboard/shared/settings_actions/_description.html.twig', {description: data.SECURITY_PGP_FINGERPRINT.description}) }}
            <div class="flex items-center space-x-2 mt-5">
                {{ form_widget(form.securityPgpFingerprint, {attr: {class: 'form-widget', autocomplete: 'off'}}) }}
            </div>
            <div class="mt-2 -mb-2 text-center text-red-500 text-base">
                {{ form_errors(form.securityPgpFingerprint) }}
            </div>
        </div>

    </div>

    {# --- INFO BANNER --- #}
    <div class="mt-2 mr-2 p-2 text-base font-semibold w-full">
        <div class="flex bg-infoBgColor/50 rounded-lg p-4 text-xs md:text-sm text-infoTextColor" role="alert">
            <twig:ux:icon name="wba:info" class="w-10 md:w-5 h-10 md:h-5 inline mr-3 fill-current" />

            <span class="font-medium">
                {{ 'securityTxtCheckMessage'|trans({}, '_securityTxt') }}
                <a href="{{ app.request.schemeAndHttpHost ~ app.request.baseUrl }}/.well-known/security.txt"
                   target="_blank" class="underline font-bold">
                    {{ app.request.schemeAndHttpHost ~ app.request.baseUrl }}/.well-known/security.txt
                </a>
            </span>
        </div>
    </div>

    <div class="mt-8 divider-solid"></div>

    {% if is_granted(constant('App\\Enum\\AdminRoleType::ROLE_SUPER_ADMIN').value) %}
        <div class="mt-6 flex flex-row w-full justify-end items-center gap-2">
            <a href="{{ path('app_dashboard_regenerate_code_admin', {type: 'settingSecurity'}) }}"
               data-confirm="{{ 'resetMessage'|trans({}, 'settings_actions_general')|e('html_attr') }}"
               class="text-sm hover:text-red-600 font-bold p-2 rounded-lg transition ease-in duration-300">
                {{ 'reset'|trans({}, 'settings_actions_general') }}
            </a>

            <button type="submit" class="btn-primary"
                    onclick="return confirm('{{ 'saveChangesMessage'|trans({}, 'settings_actions_general') }}')">
                {{ 'saveChanges'|trans({}, 'settings_actions_general') }}
            </button>
        </div>
    {% endif %}

    {{ form_rest(form) }}
    {{ form_end(form, {render_rest: false}) }}
</twig:SecurityTxtSettingsForm>
