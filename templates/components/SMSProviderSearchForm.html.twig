{% import 'dashboard/shared/_sort_arrow.html.twig' as sharedSort %}
<div {{ attributes }}>

    <div class="sm:w-auto px-5 py-4">
        <div class="flex flex-col lg:flex-row justify-between items-center space-y-6 lg:space-y-0 sm:space-x-4">

            {# Total Count #}
            <div class="flex flex-row items-center border-b-2 border-y-veryDarkButton">
                <h1 class="px-2">{{ 'totalProviders'|trans({}, '_sms') }}</h1>
                <div class="w-auto h-6 mb-1 px-2 rounded-md text-center bg-veryDarkButton text-white">
                    {{ this.totalProviders }}
                </div>
            </div>

            {# Active Provider #}
            {% if this.activeProvider %}
                <a href="{{ path('admin_dashboard_settings_sms_providers_edit', {id: this.activeProvider.id}) }}"
                   class="flex flex-row items-center group transition-all duration-100 text-gray-500 border-b-2 border-transparent hover:text-lightGreen hover:border-b-2 hover:border-y-lightGreen/50">
                    <h1 class="px-2">{{ 'activeProvider'|trans({}, '_sms') }}</h1>
                    <div class="w-auto h-6 mb-1 px-2 rounded-md text-center transition-all duration-100 bg-veryLightGreen group-hover:bg-lightGreen group-hover:text-white whitespace-nowrap">
                        {{ this.activeProvider.name }}
                    </div>
                </a>
            {% endif %}

            {# Search Bar #}
            <div class="w-full md:w-3/6">
                <div class="flex flex-row items-center border rounded-md">
                    <button type="button">
                        <svg class="w-5 mx-3 text-gray-400" fill="none" stroke="currentColor"
                             stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                        </svg>
                    </button>
                    <label class="w-full">
                        <input type="text"
                               class="form-widget w-full p-2 bg-transparent border-none outline-none"
                               placeholder="{{ 'searchProviders'|trans({}, '_sms') }}"
                               data-model="debounce(300)|query"
                               autocomplete="off" />
                    </label>
                </div>
            </div>

            {# Right Button #}
            {% if this.canWrite %}
                <a href="{{ path('admin_dashboard_settings_sms_providers_new') }}"
                   class="btn-primary px-4 min-w-[150px]">
                    {{ 'newConfiguration'|trans({}, '_sms') }}
                </a>
            {% endif %}

        </div>
    </div>

    {# Table #}
    <div class="overflow-x-auto max-w-full mt-3">
        <table class="w-full items-start">
            <thead class="text-sm text-gray-700 bg-veryLightGreen">
            <tr>
                <th scope="col" class="p-4 pl-8">{{ 'name'|trans({}, '_sms') }}</th>
                <th scope="col" class="px-6 py-3">{{ 'smsProviderType'|trans({}, '_sms') }}</th>
                <th scope="col" class="px-6 py-3">{{ 'testMode'|trans({}, '_sms') }}</th>
                <th scope="col" class="px-6 py-3">{{ 'status'|trans({}, '_sms') }}</th>
                <th scope="col" class="flex items-center px-6 py-3">
                    <h1 class="mr-2">{{ 'createdAt'|trans({}, '_sms') }}</h1>
                    <button type="button"
                            data-action="live#action"
                            data-live-action-param="changeSort"
                            data-live-field-param="createdAt"
                            class="p-1 hover:shadow-md rounded-lg cursor-pointer">
                        {{ sharedSort.sortArrow('createdAt', sort, order) }}
                    </button>
                </th>
                {% if this.canWrite %}
                    <th scope="col" class="px-6 py-3"><span class="none"></span></th>
                {% endif %}
            </tr>
            </thead>
            <tbody>
            {% for provider in this.providers %}
                {{ include('dashboard/shared/settings_actions/sms_providers/_sms_provider.html.twig', {
                    provider: provider,
                    canWrite: this.canWrite,
                    activeProviderName: this.activeProviderName,
                }) }}
            {% else %}
                <tr>
                    <td colspan="{{ this.canWrite ? 7 : 6 }}">
                        <div class="flex flex-row justify-center items-start mt-2 p-4">
                            <div class="pill-error">
                                {% if query %}
                                    {{ 'noProvidersFoundWith'|trans({}, '_sms') }} "{{ query }}"
                                {% else %}
                                    {{ 'noProvidersConfigured'|trans({}, '_sms') }}
                                {% endif %}
                            </div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination #}
    <div class="m-8">
        <hr class="w-full h-0.5 bg-gray-300/50 border-0 rounded">
        {{ include('dashboard/shared/pagination/_pagination_live.html.twig', {
            label: 'providersPerPage'|trans({}, '_sms'),
            occurrencies: this.providers|length,
            totalPages: this.totalPages,
            page: page,
            count: count,
        }) }}
    </div>
</div>
