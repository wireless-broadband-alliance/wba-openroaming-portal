{# params: body (array), uid (string, unique per route) #}
{% set flags = constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') %}
{% set isVariants = body is not empty and (body|filter(v => v is iterable)|length) == (body|length) %}

{% if isVariants %}
    <div data-controller="tabs"
         data-tabs-active-class="border-indigo-600 text-indigo-700 bg-white"
         data-tabs-inactive-class="border-transparent text-gray-500 hover:text-gray-700 bg-gray-50">

        <div role="tablist" class="flex flex-wrap gap-1 border-b border-gray-200">
            {% for label, example in body %}
                <button type="button"
                        role="tab"
                        aria-selected="false"
                        class="-mb-px rounded-t-md border-b-2 px-3 py-2 text-xs font-mono font-medium"
                        data-tabs-target="tab"
                        data-action="tabs#select"
                        data-tabs-index-param="{{ loop.index0 }}">
                    {{ label }}
                </button>
            {% endfor %}
        </div>

        {% for label, example in body %}
            {% set codeId = 'req-' ~ uid ~ '-' ~ loop.index0 %}
            <div role="tabpanel" data-tabs-target="panel" {% if not loop.first %}hidden{% endif %}>
                <div class="relative" data-controller="clipboard">
                    {{ include('shared/_copy_button.html.twig', {clipboard_target: '#' ~ codeId}) }}
                    <pre id="{{ codeId }}"
                         data-clipboard-target="code"
                         class="bg-gray-100 text-gray-800 rounded-b-lg p-4 pt-12 text-sm font-mono overflow-x-auto border border-gray-200">{{ example|json_encode(flags) }}</pre>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    {% set codeId = 'req-' ~ uid %}
    <div class="relative" data-controller="clipboard">
        {{ include('shared/_copy_button.html.twig', {clipboard_target: '#' ~ codeId}) }}
        <pre id="{{ codeId }}"
             data-clipboard-target="code"
             class="bg-gray-100 text-gray-800 rounded-lg p-4 pt-12 text-sm font-mono overflow-x-auto border border-gray-200">{{ body|json_encode(flags) }}</pre>
    </div>
{% endif %}
